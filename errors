    LEFT JOIN ref_datasource dt ON dt.datasource_num_id = sf.datasource_num_id LEFT JOIN dim_customer cus ON sf.customer_dim_key = cus.customer_dim_key LEFT JOIN ref_conversion_rates cr ON (cr.from_currency = sf.currency AND cr.to_currency = 'USD' AND year(sf.date_invoice) = cr.cnv_year AND month(sf.date_invoice) = cr.cnv_month)

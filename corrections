spark.sql(f"""
CREATE OR REPLACE TEMPORARY VIEW sf_sales_fact AS
WITH latest_snapshot AS (
    -- Automatically find the most recent full reload snapshot per datasource
    SELECT datasource_num_id, dl_load_date
    FROM (
        SELECT 
            datasource_num_id, 
            dl_load_date, 
            COUNT(*) AS record_count,
            ROW_NUMBER() OVER (PARTITION BY datasource_num_id ORDER BY COUNT(*) DESC, dl_load_date DESC) as rn
        FROM brz_teradata.udm_sales_fact
        WHERE dl_load_date > '{min_cdc_value}'
        GROUP BY datasource_num_id, dl_load_date
    ) 
    WHERE rn = 1
)
SELECT
    s.datasource_num_id, 
    TRIM(s.branch_id) AS branch_id, 
    to_date(s.date_invoice) AS date_invoice, 
    s.sales_amount, 
    s.currency, 
    s.customer_dim_key,
    TRIM(s.invoice_no) AS invoice_no, 
    TRIM(s.wesnet_order_no) AS wesnet_order_no,
    TRIM(s.order_number) AS order_number, 
    TRIM(s.order_integration_id) AS order_integration_id,
    s.accounting_include_flag,
    s.sales_transfer_flag, 
    s.kit_component_flag, 
    TRIM(s.sim_description) AS sim_description, 
    TRIM(s.inventory_org_code) AS inventory_org_code,
    s.cost_amount, 
    s.quantity, 
    s.market_cost,
    TRIM(s.transaction_type) AS transaction_type, 
    s.invoice_line_no, 
    s.conversion_rate,
    s.budget_conversion_rate, 
    TRIM(s.flex_1) AS flex_1, 
    s.dl_load_date, 
    s.updated_ts
FROM brz_teradata.udm_sales_fact s
INNER JOIN latest_snapshot ls
    ON s.datasource_num_id = ls.datasource_num_id
    AND s.dl_load_date = ls.dl_load_date
WHERE to_date(s.date_invoice) >= '2024-01-01' 
  AND s.datasource_num_id IN (3000, 4000, 5000, 6000, 7000, 8000, 9000, 10000, 11000, 12001, 12002, 12003, 12004, 12005, 13000, 14000)
""")

-- 1. Check Frozen Teradata Control Table (Frozen on June 6, 2025)
SELECT 'FROZEN_CONTROL' AS src, rollup_category, SUM(sales_amount_USD) AS total_usd
FROM dss_marts.digital_dashboard_control
WHERE datasource_num_id = 3000
  AND sbu = 'EES'
  AND date_invoice BETWEEN DATE '2025-05-01' AND DATE '2025-05-31'
GROUP BY rollup_category;




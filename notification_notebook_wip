spark.sql("""
CREATE OR REPLACE TEMPORARY VIEW dim_digital_channel AS
SELECT TRIM(ent_type) AS ent_type, datasource_num_id, TRIM(rollup_category) AS rollup_category
FROM (
    SELECT ent_type, datasource_num_id, rollup_category,
    ROW_NUMBER() OVER (
        PARTITION BY TRIM(ent_type), datasource_num_id -- REMOVED rollup_category
        ORDER BY updated_ts DESC
    ) AS rn
    FROM brz_teradata.udm_digital_channel_code_dim
) t
WHERE rn = 1
""")






SELECT 
    ent_type, 
    rollup_category, 
    COUNT(*) AS total_rows,
    SUM(sales_amount) AS total_sales_amount
FROM gld_eudm.digital_dashboard_control
WHERE datasource_num_id = 3000
GROUP BY ent_type, rollup_category
ORDER BY total_rows DESC;





SELECT 
    COUNT(*) AS total_wesnet_records,
    COUNT(CASE WHEN rollup_category IS NULL THEN 1 END) AS null_rollup_category_count,
    COUNT(CASE WHEN ent_type IS NULL THEN 1 END) AS null_ent_type_count
FROM gld_eudm.digital_dashboard_control
WHERE datasource_num_id = 3000;

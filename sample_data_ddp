-- Find records in the recalculated view that are NOT in the physical summary table
SELECT 
    datasource_num_id,
    rollup_category,
    month_of_year,
    total_sales_amount,
    total_sales_amount_usd
FROM gld_eudm.vw_digital_revenue_dashboard

EXCEPT

-- Find records in the physical summary table that are NOT in the recalculated view
SELECT 
    datasource_num_id,
    rollup_category,
    month_of_year,
    sales_amount AS total_sales_amount,
    sales_amount_usd AS total_sales_amount_usd
FROM gld_eudm.digital_dashboard_control_summary
WHERE month_of_year <> date_format(current_date(), 'yyyy-MM');

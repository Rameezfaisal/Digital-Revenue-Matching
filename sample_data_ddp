CREATE TABLE IF NOT EXISTS gld_eudm.digital_dashboard_control_summary (
    datasource_num_id INT COMMENT 'Unique identifier for the data source',
    rollup_category STRING COMMENT 'Category for digital rollup',
    month_of_year STRING COMMENT 'Invoice month and year in YYYY-MM format',
    total_no_of_sales BIGINT COMMENT 'Aggregated total number of sales',
    sales_amount DECIMAL(38, 2) COMMENT 'Aggregated total sales amount in local currency',
    sales_amount_usd DECIMAL(38, 2) COMMENT 'Aggregated total sales amount converted to USD',
    create_date DATE COMMENT 'Date the record was created/processed',
    dl_load_ts TIMESTAMP COMMENT 'Data lake load timestamp',
    dl_updated_ts TIMESTAMP COMMENT 'Data lake update timestamp'
)
USING DELTA
TBLPROPERTIES (
    'delta.appendOnly' = 'false',
    'delta.autoOptimize.optimizeWrite' = 'true',
    'delta.autoOptimize.autoCompact' = 'true'
)
COMMENT 'Summary table for digital dashboard control aggregated by datasource, rollup category, and month';

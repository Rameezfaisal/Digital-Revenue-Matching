-- 1. Update the standalone currency_conversion column:
CAST(coalesce(cr.conversion_rate, 1) AS DECIMAL(38,10)) as currency_conversion,

-- 2. Update the sales_amount_USD math column:
CAST(
    CAST(SUM(sf.sales_amount) AS DECIMAL(38,2)) * 
    CAST(coalesce(cr.conversion_rate, 1) AS DECIMAL(38,10)) 
AS DECIMAL(38,2)) as sales_amount_USD

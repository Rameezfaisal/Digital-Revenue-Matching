# DBTITLE 1,email alert function
from pyspark.sql import SparkSession
from pyspark.dbutils import DBUtils
import json, re, html
import smtplib, ssl
from email.mime.text import MIMEText
from email.mime.multipart import MIMEMultipart
import re, json

spark = SparkSession.getActiveSession() or SparkSession.builder.getOrCreate()
dbutils = DBUtils(spark)

def send_email(job_status_df, env_val, success_email_to,businessunit):
    
    SMTP_HOST = "smtp.office365.com"
    SMTP_PORT = 587

    SMTP_USER = dbutils.secrets.get("ddpscopekeyvault001", "kvSvcDDPDatabricksNPUserName")
    SMTP_PASS = dbutils.secrets.get("ddpscopekeyvault001", "kvSvcDDPDatabricksnp")

    EMAIL_SPLIT = re.compile(r"[;,]")

    def split_emails(val):
        if isinstance(val, list):
            parts = val
        elif isinstance(val, str):
            parts = EMAIL_SPLIT.split(val)
        else:
            parts = []
        seen, out = set(), []
        for e in parts:
            if not isinstance(e, str):
                continue
            s = e.strip()
            if s and s.lower() not in seen:
                seen.add(s.lower())
                out.append(s)
        return out

    recipients = split_emails(f"{success_email_to}")
    print(recipients)

    wesco_spark_df = spark.sql(f"select * from {job_status_df}")
    wesco_df = wesco_spark_df.toPandas()
    html_table = wesco_df.to_html(index=False, border=1)

    body_html = f"""<html><body><p>Hi Team,<br>Please find the {env_val} load status below:</p>{html_table}</body></html>""".strip()

    subject = f"{env_val}-{businessunit} JOB RUN STATUS REPORT:{datetime.now().strftime('%Y-%m-%d')}"

    to_list = recipients
    from_addr = SMTP_USER

    msg = MIMEMultipart("alternative")
    msg["From"] = from_addr
    msg["To"] = ", ".join(to_list)
    msg["Subject"] = subject

    msg.attach(MIMEText(body_html, "html"))

    ctx = ssl.create_default_context()
    with smtplib.SMTP(SMTP_HOST, SMTP_PORT, timeout=30) as s:
        print("[SMTP] EHLO 1:", s.ehlo())
        print("[SMTP] STARTTLS:", s.starttls(context=ctx))
        print("[SMTP] EHLO 2:", s.ehlo())
        print("[SMTP] AUTH LOGIN…")
        s.login(SMTP_USER, SMTP_PASS)
        s.sendmail(msg["From"], recipients, msg.as_string())

    print("Email sent via SMTP:", subject)


# Check Run Condition (6th Work Day) - Exits early if condition is not met

check_workday_df = spark.sql(f"""
SELECT count(*) as valid_day
FROM brz_teradata.calendar_work_day
WHERE day_of_month = 10 AND calendar_date = current_date()
""")

if check_workday_df.collect()[0]["valid_day"] == 0:
    dbutils.notebook.exit('{"Status": "Skipped", "Reason": "Today is not the 6th working day."}')

print("Run condition met. Proceeding with load.")

SELECT 
    datasource_num_id, 
    invoice_no, 
    order_number, 
    date_invoice, 
    COUNT(*) as duplicate_count
FROM slv_salesorder.digital_dashboard_control
GROUP BY 
    datasource_num_id, 
    invoice_no, 
    order_number, 
    date_invoice
HAVING COUNT(*) > 1;






SELECT 
    datasource_num_id,
    COUNT(*) as zero_sales_records
FROM slv_salesorder.digital_dashboard_control
WHERE sales_amount = 0
GROUP BY datasource_num_id;






SELECT 
    datasource_num_id,
    currency,
    sales_amount,
    currency_conversion,
    sales_amount_USD,
    ROUND(CAST(sales_amount AS DECIMAL(38,2)) * currency_conversion, 2) AS calculated_usd,
    ABS(sales_amount_USD - ROUND(CAST(sales_amount AS DECIMAL(38,2)) * currency_conversion, 2)) AS variance
FROM slv_salesorder.digital_dashboard_control
WHERE ABS(sales_amount_USD - ROUND(CAST(sales_amount AS DECIMAL(38,2)) * currency_conversion, 2)) > 0.01;







SELECT 
    datasource_num_id, 
    currency, 
    COUNT(*) as missing_rate_count
FROM slv_salesorder.digital_dashboard_control
WHERE currency_conversion IS NULL 
   OR sales_amount_USD IS NULL
GROUP BY datasource_num_id, currency;






SELECT 
    datasource_num_id, 
    MIN(date_invoice) AS oldest_invoice_date,
    MAX(date_invoice) AS newest_invoice_date,
    MAX(dl_updated_ts) AS last_modified_timestamp,
    COUNT(*) AS total_rows
FROM slv_salesorder.digital_dashboard_control
GROUP BY datasource_num_id
ORDER BY datasource_num_id;



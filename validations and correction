SELECT 
    rollup_category,
    SUM(total_no_of_sales) AS total_no_of_sales,
    ROUND(SUM(sales_amount_usd), 2) AS digital_revenue_usd
FROM gld_eudm.digital_dashboard_control_summary
WHERE datasource_num_id = 3000
  AND month_of_year = '2025-05'
GROUP BY rollup_category
ORDER BY digital_revenue_usd DESC;





SELECT 
    COALESCE(sbu, 'TOTAL') AS sbu,
    ROUND(SUM(CASE WHEN rollup_category = 'Materials Management' THEN sales_amount_USD ELSE 0 END), 2) AS materials_management_rev,
    ROUND(SUM(sales_amount_USD), 2) AS total_digital_revenue,
    ROUND(SUM(CASE WHEN rollup_category = 'Integrations' THEN sales_amount_USD ELSE 0 END), 2) AS integrations_rev,
    ROUND(SUM(CASE WHEN rollup_category = 'Websites' THEN sales_amount_USD ELSE 0 END), 2) AS websites_rev
FROM gld_eudm.digital_dashboard_control
WHERE datasource_num_id = 3000
  AND date_invoice >= '2025-05-01' 
  AND date_invoice <= '2025-05-31'
GROUP BY GROUPING SETS ((sbu), ())
ORDER BY sbu;





SELECT 
    COUNT(DISTINCT order_number) AS distinct_digital_orders,
    SUM(total_no_of_sales) AS total_sales_metric
FROM gld_eudm.digital_dashboard_control
WHERE datasource_num_id = 3000
  AND date_invoice >= '2025-05-01' 
  AND date_invoice <= '2025-05-31';




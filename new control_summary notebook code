# COMMAND ----------
# Replicate Teradata's max_date_loaded logic to only process newly added months
spark.sql("""
CREATE OR REPLACE TEMPORARY VIEW max_loaded_summary AS
SELECT 
    datasource_num_id, 
    MAX(month_of_year) AS max_month_loaded
FROM gld_eudm.digital_dashboard_control_summary
GROUP BY datasource_num_id
""")

# COMMAND ----------
# DBTITLE 1,with decimal precision
main_df = spark.sql(f""" 
WITH new_data AS (
    SELECT 
        d.datasource_num_id, 
        d.rollup_category, 
        date_format(d.date_invoice, 'yyyy-MM') AS month_of_year, 
        d.total_no_of_sales, 
        d.sales_amount, 
        d.sales_amount_usd 
    FROM gld_eudm.digital_dashboard_control d
    LEFT JOIN max_loaded_summary m ON d.datasource_num_id = m.datasource_num_id
    WHERE d.datasource_num_id IN (3000, 4000, 5000, 6000, 7000, 8000, 9000, 10000, 11000, 12001, 12002, 12003, 12004, 12005, 13000, 14000) 
      AND date_format(d.date_invoice, 'yyyy-MM') > COALESCE(m.max_month_loaded, '1900-01')
)
SELECT 
    datasource_num_id, 
    rollup_category, 
    month_of_year, 
    CAST(SUM(total_no_of_sales) AS BIGINT) AS total_no_of_sales, 
    CAST(SUM(sales_amount) AS DECIMAL(38,2)) AS sales_amount, 
    CAST(SUM(sales_amount_usd) AS DECIMAL(38,12)) AS sales_amount_usd, 
    current_date() AS create_date 
FROM new_data 
GROUP BY datasource_num_id, rollup_category, month_of_year 
""")

# COMMAND ----------

from pyspark.sql.types import StructType, StructField, StringType, DecimalType
from pyspark.sql.functions import col, round, expr

# 1. Create a Dummy DataFrame with the HIGH PRECISION rate from the raw data
data = [("12004", "JPY", 3312000.00, 0.00640820048)]
schema = StructType([
    StructField("datasource_num_id", StringType(), True),
    StructField("currency", StringType(), True),
    StructField("sales_amount", DecimalType(38, 2), True),
    StructField("raw_conversion_rate", DecimalType(38, 11), True) # Simulating bronze lake precision
])

df = spark.createDataFrame(data, schema)

# 2. Replicate the Databricks notebook math
test_df = df.withColumn(
    "currency_conversion", 
    col("raw_conversion_rate").cast("decimal(38,6)") # Simulating a truncated column save
).withColumn(
    "sales_amount_USD", 
    (col("sales_amount") * col("raw_conversion_rate")).cast("decimal(38,2)") # How Databricks calculated the USD
)

# 3. Replicate the Validation Query Math
validation_df = test_df.withColumn(
    "calculated_usd",
    round(col("sales_amount") * col("currency_conversion"), 2)
).withColumn(
    "variance",
    abs(col("sales_amount_USD") - col("calculated_usd"))
)

display(validation_df)

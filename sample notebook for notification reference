# DBTITLE 1,teams report function
import io, base64
import pandas as pd
import matplotlib.pyplot as plt
import requests
from datetime import datetime
import pytz

def teams_job_report(job_status_df, webhook_url, env_val,businessunit):
    def df_to_png_bytes(df: pd.DataFrame, max_rows=40, max_cols=12, dpi=300) -> bytes:
        df = df.iloc[:max_rows, :max_cols].copy()
        fig, ax = plt.subplots(figsize=(min(13, 0.18 * max(3, df.shape[1]) * 12),
                                        min(15, 0.35 * max(3, df.shape[0]))),
                               dpi=dpi)
        ax.axis('off')
        
        if businessunit=="GOLD_EUDM":
            col_widths = [0.07, 0.20, 0.06, 0.24, 0.11]
        else:
            col_widths = [0.07, 0.17, 0.07, 0.07, 0.11, 0.09, 0.13, 0.30]

        tbl = ax.table(cellText=df.values,
                       colLabels=[str(c) for c in df.columns],
                       colWidths=col_widths,
                       loc='center',
                       cellLoc='left',
                       colLoc='left')
        tbl.auto_set_font_size(False)
        tbl.set_fontsize(14)
        tbl.scale(1.5, 2.2)
        buf = io.BytesIO()
        plt.tight_layout()
        fig.savefig(buf, format='png', bbox_inches='tight', pad_inches=0.2)
        plt.close(fig)
        buf.seek(0)
        return buf.read()


    # Query Spark and convert to pandas DataFrame
    if businessunit=="GOLD_EUDM":
        status_df = spark.sql(f"""
        select operation_id,target_table_name,owner,Last_execution_time,STATUS as status
        from  {job_status_df}""")
    else:
        status_df = spark.sql(f"""
        select job_id, Domain, Owner, Active_Operations as Active, Completed, Pending, Job_Status, Failed_operations 
        from {job_status_df}""")

    df = status_df.toPandas()

    # Get current time in IST
    ist = pytz.timezone('Asia/Kolkata')
    current_time_ist = datetime.now(ist).strftime('%Y-%m-%d %H:%M')

    # Prepare and send the main report as an image
    png_bytes = df_to_png_bytes(df)
    b64 = base64.b64encode(png_bytes).decode("utf-8")
    data_uri = f"data:image/png;base64,{b64}"

    report_payload = {
        "type": "message",
        "attachments": [
            {
                "contentType": "application/vnd.microsoft.card.adaptive",
                "content": {
                    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
                    "type": "AdaptiveCard",
                    "version": "1.4",
                    "body": [
                        {
                            "type": "RichTextBlock",
                            "inlines": [
                                {"type": "TextRun", "text": "Hi Team,"},
                                {"type": "TextRun", "text": "\n"},
                                {"type": "TextRun", "text": f"Please find the {env_val}-{businessunit} load status below : {current_time_ist}"},
                            ],
                            "wrap": True
                        },
                        {
                            "type": "Image",
                            "url": data_uri,
                            "size": "Stretch"
                        }
                    ]
                }
            }
        ]
    }
    report_response = requests.post(webhook_url, json=report_payload)

    # Prepare and send the failed operations list
    if businessunit !="GOLD_EUDM":
        
        # Prepare failed operations string
        failed_ops_lists = df['Failed_operations'].str.split(', ')
        all_failed_operations = [op for sublist in failed_ops_lists for op in sublist if op]
        all_failed_operations_str = ', '.join(all_failed_operations)

        if len(all_failed_operations_str) != 0:
            # send the failed operations list
            failed_ops_payload = {
                "type": "message",
                "attachments": [
                    {
                        "contentType": "application/vnd.microsoft.card.adaptive",
                        "content": {
                            "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
                            "type": "AdaptiveCard",
                            "version": "1.4",
                            "body": [
                                {
                                    "type": "RichTextBlock",
                                    "inlines": [
                                        {"type": "TextRun", "text": "Hi Team,"},
                                        {"type": "TextRun", "text": "\n"},
                                        {"type": "TextRun", "text": f"Please find the list of Failed Operation in {env_val}-{businessunit} :"},
                                        {"type": "TextRun", "text": "\n"},
                                        {"type": "TextRun", "text": f"{all_failed_operations_str}"}
                                    ],
                                    "wrap": True
                                }
                            ]
                        }
                    }
                ]
            }
            failed_ops_response = requests.post(webhook_url, json=failed_ops_payload)

    # return {
    #     "report_status_code": report_response.status_code,
    #     "failed_ops_status_code": failed_ops_response.status_code
    # }


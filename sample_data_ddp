SELECT datasource_num_id, COUNT(*) AS spark_count
FROM gld_eudm.digital_dashboard_control_summary
GROUP BY datasource_num_id
ORDER BY datasource_num_id;





SELECT datasource_num_id, COUNT(*) AS td_count
FROM dss_marts.digital_dashboard_control_summary
GROUP BY datasource_num_id
ORDER BY datasource_num_id;





SELECT 
    COUNT(CASE WHEN rollup_category IS NULL THEN 1 END) AS null_rollup_count,
    COUNT(CASE WHEN month_of_year IS NULL THEN 1 END) AS null_month_count
FROM gld_eudm.digital_dashboard_control_summary;




SELECT 
    datasource_num_id, 
    MIN(month_of_year) AS min_month, 
    MAX(month_of_year) AS max_month,
    COUNT(DISTINCT month_of_year) AS distinct_months
FROM gld_eudm.digital_dashboard_control_summary
GROUP BY datasource_num_id
ORDER BY datasource_num_id;




SELECT 
    datasource_num_id, 
    MIN(TO_CHAR(DATE_INVOICE, 'YYYY-MM')) AS min_month, 
    MAX(TO_CHAR(DATE_INVOICE, 'YYYY-MM')) AS max_month,
    COUNT(DISTINCT TO_CHAR(DATE_INVOICE, 'YYYY-MM')) AS distinct_months
FROM dss_marts.digital_dashboard_control_summary
GROUP BY datasource_num_id
ORDER BY datasource_num_id;






SELECT spark.*
FROM gld_eudm.digital_dashboard_control_summary spark
LEFT ANTI JOIN tmp_teradata_summary td
    ON spark.datasource_num_id = td.datasource_num_id
   AND COALESCE(spark.rollup_category, '') = COALESCE(td.rollup_category, '')
   AND spark.month_of_year = td.month_of_year;


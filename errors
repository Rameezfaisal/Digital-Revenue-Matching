    -- 6. Hazmasters (14000)
    SELECT sf.datasource_num_id, bd.sbu, uof.ent_type, doc.rollup_category, sf.date_invoice, count(distinct sf.order_number) as total_no_of_sales, sum(sf.sales_amount) as sales_amount, sf.currency, dt.datasource_description as data_source_name, concat(cus.customer_no, '_', cus.customer_name) as cust_name, sf.invoice_no, sf.order_number, coalesce(cr.conversion_rate, 1) as currency_conversion, (cast(sum(sf.sales_amount) as DECIMAL(38,2)) * coalesce(cr.conversion_rate, 1)) as sales_amount_USD, current_date() as CREATE_DATE
    FROM base_incremental_sales sf
    LEFT JOIN (SELECT distinct ent_type, sales_order_no, branch_id FROM of_order_fact WHERE datasource_num_id = '14000') uof 
        ON (uof.sales_order_no = sf.order_number AND sf.branch_id = uof.branch_id)
    LEFT JOIN dim_branch bd ON sf.branch_id = bd.branch_id LEFT JOIN dim_digital_channel doc ON (doc.ent_type = uof.ent_type AND doc.datasource_num_id = sf.datasource_num_id) LEFT JOIN ref_datasource dt ON dt.datasource_num_id = sf.datasource_num_id LEFT JOIN dim_customer cus ON sf.customer_dim_key = cus.customer_dim_key LEFT JOIN ref_conversion_rates cr ON (cr.from_currency = sf.currency AND cr.to_currency = 'USD' AND year(sf.date_invoice) = cr.cnv_year AND month(sf.date_invoice) = cr.cnv_month)
    WHERE sf.datasource_num_id = 14000 AND sf.accounting_include_flag = 'Y' AND coalesce(sf.sales_transfer_flag, 'N') <> 'Y' AND coalesce(sf.kit_component_flag, 'N') <> 'C'
    GROUP BY sf.datasource_num_id, uof.ent_type, bd.sbu, doc.rollup_category, sf.date_invoice, sf.currency, cus.customer_name, cus.customer_no, sf.invoice_no, sf.order_number, dt.datasource_description, cr.conversion_rate
    HAVING sum(sf.sales_amount) <> 0

    UNION ALL

    -- 7. WIS (10000)
    SELECT sf.datasource_num_id, bd.sbu, coalesce(uof.ent_type, 'e-Crib') as ent_type, coalesce(doc.rollup_category, 'Materials Management') as rollup_category, sf.date_invoice, count(distinct sf.order_number) as total_no_of_sales, sum(sf.sales_amount) as sales_amount, sf.currency, dt.datasource_description as data_source_name, concat(cus.customer_no, '_', cus.customer_name) as cust_name, sf.invoice_no, sf.order_number, coalesce(cr.conversion_rate, 1) as currency_conversion, (cast(sum(sf.sales_amount) as DECIMAL(38,2)) * coalesce(cr.conversion_rate, 1)) as sales_amount_USD, current_date() as CREATE_DATE
    FROM base_incremental_sales sf
    LEFT JOIN (SELECT distinct ent_type, sales_order_no, branch_id FROM of_order_fact WHERE datasource_num_id = '10000') uof 
        ON (sf.order_number = uof.sales_order_no AND sf.branch_id = uof.branch_id)
    LEFT JOIN dim_branch bd ON sf.branch_id = bd.branch_id LEFT JOIN dim_digital_channel doc ON (doc.ent_type = uof.ent_type AND doc.datasource_num_id = sf.datasource_num_id) LEFT JOIN ref_datasource dt ON dt.datasource_num_id = sf.datasource_num_id LEFT JOIN dim_customer cus ON sf.customer_dim_key = cus.customer_dim_key LEFT JOIN ref_conversion_rates cr ON (cr.from_currency = sf.currency AND cr.to_currency = 'USD' AND year(sf.date_invoice) = cr.cnv_year AND month(sf.date_invoice) = cr.cnv_month)
    WHERE sf.datasource_num_id = 10000
    GROUP BY sf.datasource_num_id, coalesce(uof.ent_type, 'e-Crib'), bd.sbu, coalesce(doc.rollup_category, 'Materials Management'), sf.date_invoice, sf.currency, cus.customer_name, cus.customer_no, sf.invoice_no, sf.order_number, dt.datasource_description, cr.conversion_rate
    HAVING sum(sf.sales_amount) <> 0


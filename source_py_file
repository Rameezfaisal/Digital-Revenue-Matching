# Execute the Bidirectional Mismatch Audit Query
mismatch_df = spark.sql("""
    (
        SELECT 
            datasource_num_id,
            rollup_category,
            month_of_year,
            total_sales_amount,
            total_sales_amount_usd
        FROM gld_eudm.vw_digital_revenue_dashboard

        EXCEPT

        SELECT 
            datasource_num_id,
            rollup_category,
            month_of_year,
            sales_amount AS total_sales_amount,
            sales_amount_usd AS total_sales_amount_usd
        FROM gld_eudm.digital_dashboard_control_summary
        WHERE month_of_year <> date_format(current_date(), 'yyyy-MM')
    )
    
    UNION ALL

    (
        SELECT 
            datasource_num_id,
            rollup_category,
            month_of_year,
            sales_amount AS total_sales_amount,
            sales_amount_usd AS total_sales_amount_usd
        FROM gld_eudm.digital_dashboard_control_summary
        WHERE month_of_year <> date_format(current_date(), 'yyyy-MM')
        
        EXCEPT

        SELECT 
            datasource_num_id,
            rollup_category,
            month_of_year,
            total_sales_amount,
            total_sales_amount_usd
        FROM gld_eudm.vw_digital_revenue_dashboard
    )
""")

# COMMAND ----------

mismatch_count = mismatch_df.count()

if mismatch_count > 0:
    print(f"Data validation failed: Found {mismatch_count} mismatched records.")
    
    # 1. Add audit timestamp and write to the Delta audit table
    audit_df = mismatch_df.withColumn("audit_timestamp", current_timestamp())
    audit_df.write \
        .format("delta") \
        .mode("append") \
        .saveAsTable("gld_eudm.digital_dashboard_records_mismatch")
    
    # 2. Export mismatch records to a local CSV file for email attachment
    mismatch_df.toPandas().to_csv(LOCAL_CSV_PATH, index=False)
    
    # 3. Send mismatch email with CSV attachment
    email_body = "Please find attached the records summary having difference in source and digital dashboard control summary table."
    send_smtp_email(SUBJECT, email_body, RECIPIENTS, attachment_path=LOCAL_CSV_PATH)
    
    # Clean up local temporary CSV file
    if os.path.exists(LOCAL_CSV_PATH):
        os.remove(LOCAL_CSV_PATH)
        
    # 4. Fail the notebook job run to alert pipeline orchestrator
    raise Exception(f"Digital Dashboard Mismatch Audit Failed! {mismatch_count} rows differ. Please query gld_eudm.digital_dashboard_records_mismatch for details.")

else:
    print("Data validation passed: No mismatches found between the view and summary table.")
    
    # Send success email matching Teradata script behavior
    email_body = "There is no mismatch between Digital Dashboard and Source Record"
    send_smtp_email(SUBJECT, email_body, RECIPIENTS)

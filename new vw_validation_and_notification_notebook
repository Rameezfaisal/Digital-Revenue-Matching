# DBTITLE 1,Run Live 12-Block Data Logic (Invoice Grain matching Control Notebook)
spark.sql("""
CREATE OR REPLACE TEMPORARY VIEW vw_live_bronze_details AS
SELECT * FROM (

    -- 1. WESNET (3000)
    SELECT sf.datasource_num_id, bd.sbu, uof.flex_1 as ent_type, doc.rollup_category, sf.date_invoice,
    count(*) as total_no_of_sales, SUM(CAST(sf.sales_amount AS DECIMAL(38,2))) as sales_amount, sf.currency, dt.datasource_description as data_source_name, concat(cus.customer_no, '_', cus.customer_name) as cust_name, sf.invoice_no, sf.wesnet_order_no as order_number,
    CAST(coalesce(CASE WHEN sf.currency = 'USD' THEN 1 ELSE cr.conversion_rate END, 1) AS DECIMAL(18,6)) as currency_conversion, 
    CAST(CAST(SUM(sf.sales_amount) AS DECIMAL(38,2)) * coalesce(CASE WHEN sf.currency = 'USD' THEN 1 ELSE cr.conversion_rate END, 1) AS DECIMAL(38,12)) as sales_amount_USD, 
    current_date() as CREATE_DATE
    FROM sf_sales_fact sf
    LEFT JOIN (
        SELECT TRIM(sales_order_no) AS sales_order_no, TRIM(branch_id) as branch_id, datasource_num_id, TRIM(order_integration_id) AS order_integration_id, TRIM(flex_1) AS flex_1
        FROM (SELECT sales_order_no, branch_id, datasource_num_id, order_integration_id, flex_1, ROW_NUMBER() OVER (PARTITION BY datasource_num_id, TRIM(sales_order_no), TRIM(branch_id), TRIM(order_integration_id) ORDER BY CASE WHEN TRIM(flex_1) IS NOT NULL AND TRIM(flex_1) <> '' THEN 0 ELSE 1 END, order_updated_ts DESC, dl_load_date DESC) AS rn FROM brz_teradata.udm_order_fact WHERE datasource_num_id = 3000) WHERE rn = 1
    ) uof ON (uof.sales_order_no = sf.wesnet_order_no AND CAST(uof.datasource_num_id AS INT) = CAST(sf.datasource_num_id AS INT) AND uof.branch_id = sf.branch_id AND uof.order_integration_id = sf.order_integration_id)
    LEFT JOIN dim_branch bd ON sf.branch_id = bd.branch_id 
    LEFT JOIN dim_digital_channel doc ON (doc.ent_type = uof.flex_1 AND doc.datasource_num_id = uof.datasource_num_id)
    LEFT JOIN ref_datasource dt ON dt.datasource_num_id = sf.datasource_num_id 
    LEFT JOIN dim_customer cus ON sf.customer_dim_key = cus.customer_dim_key 
    LEFT JOIN ref_conversion_rates cr ON (cr.from_currency = sf.currency AND cr.to_currency = 'USD' AND year(sf.date_invoice) = cr.cnv_year AND month(sf.date_invoice) = cr.cnv_month)
    WHERE sf.datasource_num_id = 3000 AND sf.accounting_include_flag = 'Y' AND coalesce(sf.sales_transfer_flag, 'N') <> 'Y' AND coalesce(sf.kit_component_flag, 'N') <> 'C' AND left(cus.customer_no, 1) <> 'X' AND sf.sim_description <> 'Datacom Redaction' AND coalesce(sf.inventory_org_code, '') <> 'SCS' AND (sf.sales_amount <> 0 OR sf.cost_amount <> 0 OR sf.quantity <> 0 OR sf.market_cost <> 0) AND sf.transaction_type <> 'X99'
    GROUP BY sf.datasource_num_id, uof.flex_1, bd.sbu, doc.rollup_category, sf.date_invoice, sf.currency, cus.customer_name, cus.customer_no, sf.invoice_no, sf.wesnet_order_no, dt.datasource_description, cr.conversion_rate
    HAVING SUM(CAST(sf.sales_amount AS DECIMAL(38,2))) <> 0

    UNION ALL

    -- 2. LIBERTY (5000)
    SELECT sf.datasource_num_id, bd.sbu, uof.ent_type, doc.rollup_category, sf.date_invoice, count(distinct sf.order_number) as total_no_of_sales, SUM(CAST(sf.sales_amount AS DECIMAL(38,2))) as sales_amount, sf.currency, dt.datasource_description as data_source_name, concat(cus.customer_no, '_', cus.customer_name) as cust_name, sf.invoice_no, sf.order_number,
    CAST(coalesce(CASE WHEN sf.currency = 'USD' THEN 1 ELSE cr.conversion_rate END, 1) AS DECIMAL(18,6)) as currency_conversion, 
    CAST(CAST(SUM(sf.sales_amount) AS DECIMAL(38,2)) * coalesce(CASE WHEN sf.currency = 'USD' THEN 1 ELSE cr.conversion_rate END, 1) AS DECIMAL(38,12)) as sales_amount_USD, 
    current_date() as CREATE_DATE
    FROM sf_sales_fact sf
    LEFT JOIN (
        SELECT TRIM(ent_type) AS ent_type, TRIM(sales_order_no) AS sales_order_no, TRIM(branch_id) as branch_id 
        FROM (SELECT ent_type, sales_order_no, branch_id, ROW_NUMBER() OVER (PARTITION BY datasource_num_id, TRIM(sales_order_no), TRIM(branch_id) ORDER BY CASE WHEN TRIM(ent_type) IS NOT NULL AND TRIM(ent_type) <> '' THEN 0 ELSE 1 END, order_updated_ts DESC, dl_load_date DESC) AS rn FROM brz_teradata.udm_order_fact WHERE datasource_num_id = 5000) WHERE rn = 1
    ) uof ON (uof.sales_order_no = sf.order_number AND sf.branch_id = uof.branch_id)
    LEFT JOIN dim_branch bd ON sf.branch_id = bd.branch_id 
    LEFT JOIN dim_digital_channel doc ON (doc.ent_type = uof.ent_type AND doc.datasource_num_id = sf.datasource_num_id)
    LEFT JOIN ref_datasource dt ON dt.datasource_num_id = sf.datasource_num_id 
    LEFT JOIN dim_customer cus ON sf.customer_dim_key = cus.customer_dim_key 
    LEFT JOIN ref_conversion_rates cr ON (cr.from_currency = sf.currency AND cr.to_currency = 'USD' AND year(sf.date_invoice) = cr.cnv_year AND month(sf.date_invoice) = cr.cnv_month)
    WHERE sf.datasource_num_id = 5000
    GROUP BY sf.datasource_num_id, uof.ent_type, bd.sbu, doc.rollup_category, sf.date_invoice, sf.currency, cus.customer_name, cus.customer_no, sf.invoice_no, sf.order_number, dt.datasource_description, cr.conversion_rate
    HAVING SUM(CAST(sf.sales_amount AS DECIMAL(38,2))) <> 0

    UNION ALL

    -- 3. ERP (9000)
    SELECT sf.datasource_num_id, bd.sbu, uof.ent_type, doc.rollup_category, sf.date_invoice, count(*) as total_no_of_sales, SUM(CAST(sf.sales_amount AS DECIMAL(38,2))) as sales_amount, sf.currency, dt.datasource_description as data_source_name, concat(cus.customer_no, '_', cus.customer_name) as cust_name, sf.invoice_no, sf.order_number,
    CAST(coalesce(CASE WHEN sf.currency = 'USD' THEN 1 ELSE cr.conversion_rate END, 1) AS DECIMAL(18,6)) as currency_conversion, 
    CAST(CAST(SUM(sf.sales_amount) AS DECIMAL(38,2)) * coalesce(CASE WHEN sf.currency = 'USD' THEN 1 ELSE cr.conversion_rate END, 1) AS DECIMAL(38,12)) as sales_amount_USD, 
    current_date() as CREATE_DATE
    FROM sf_sales_fact sf
    LEFT JOIN (
        SELECT datasource_num_id, TRIM(sales_order_no) AS sales_order_no, TRIM(branch_id) as branch_id, TRIM(ent_type) AS ent_type 
        FROM (SELECT sales_order_no, datasource_num_id, branch_id, ent_type, ROW_NUMBER() OVER (PARTITION BY datasource_num_id, TRIM(sales_order_no) ORDER BY CASE WHEN TRIM(ent_type) IS NOT NULL AND TRIM(ent_type) <> '' THEN 0 ELSE 1 END, order_updated_ts DESC, dl_load_date DESC) AS rn FROM brz_teradata.udm_order_fact WHERE datasource_num_id = 9000) WHERE rn = 1
    ) uof ON (uof.sales_order_no = sf.order_number AND CAST(uof.datasource_num_id AS INT) = CAST(sf.datasource_num_id AS INT))
    LEFT JOIN dim_branch bd ON sf.branch_id = bd.branch_id 
    LEFT JOIN dim_digital_channel doc ON (doc.ent_type = uof.ent_type AND doc.datasource_num_id = uof.datasource_num_id)
    LEFT JOIN ref_datasource dt ON dt.datasource_num_id = sf.datasource_num_id 
    LEFT JOIN dim_customer cus ON sf.customer_dim_key = cus.customer_dim_key 
    LEFT JOIN ref_conversion_rates cr ON (cr.from_currency = sf.currency AND cr.to_currency = 'USD' AND year(sf.date_invoice) = cr.cnv_year AND month(sf.date_invoice) = cr.cnv_month)
    WHERE sf.datasource_num_id = 9000 AND coalesce(sf.sales_transfer_flag, 'N') <> 'Y' AND coalesce(sf.kit_component_flag, 'N') <> 'C' AND left(cus.customer_no, 1) <> 'X' AND sf.sim_description <> 'Datacom Redaction' AND (sf.sales_amount <> 0 OR sf.cost_amount <> 0 OR sf.quantity <> 0 OR sf.market_cost <> 0) AND sf.transaction_type <> 'X99'
    GROUP BY sf.datasource_num_id, uof.ent_type, bd.sbu, doc.rollup_category, sf.date_invoice, sf.currency, cus.customer_name, cus.customer_no, sf.invoice_no, sf.order_number, dt.datasource_description, cr.conversion_rate
    HAVING SUM(CAST(sf.sales_amount AS DECIMAL(38,2))) <> 0

    UNION ALL

    -- 4. Conney (13000)
    SELECT sf.datasource_num_id, bd.sbu, uof.ent_type, doc.rollup_category, sf.date_invoice, count(distinct sf.order_number) as total_no_of_sales, SUM(CAST(sf.sales_amount AS DECIMAL(38,2))) as sales_amount, sf.currency, dt.datasource_description as data_source_name, concat(cus.customer_no, '_', cus.customer_name) as cust_name, sf.invoice_no, sf.order_number, 
    CAST(coalesce(CASE WHEN sf.currency = 'USD' THEN 1 ELSE cr.conversion_rate END, 1) AS DECIMAL(18,6)) as currency_conversion, 
    CAST(CAST(SUM(sf.sales_amount) AS DECIMAL(38,2)) * coalesce(CASE WHEN sf.currency = 'USD' THEN 1 ELSE cr.conversion_rate END, 1) AS DECIMAL(38,12)) as sales_amount_USD, 
    current_date() as CREATE_DATE
    FROM sf_sales_fact sf
    LEFT JOIN (
        SELECT TRIM(ent_type) AS ent_type, TRIM(sales_order_no) AS sales_order_no, TRIM(branch_id) as branch_id
        FROM (SELECT ent_type, sales_order_no, branch_id, ROW_NUMBER() OVER (PARTITION BY datasource_num_id, TRIM(sales_order_no), TRIM(branch_id) ORDER BY CASE WHEN TRIM(ent_type) IS NOT NULL AND TRIM(ent_type) <> '' THEN 0 ELSE 1 END, order_updated_ts DESC, dl_load_date DESC) AS rn FROM brz_teradata.udm_order_fact WHERE datasource_num_id = 13000 AND TRIM(ent_type) IN (SELECT doc2.ent_type FROM dim_digital_channel doc2 WHERE doc2.datasource_num_id = 13000 AND doc2.rollup_category IN ('Websites','Materials Management','Integrations'))) WHERE rn = 1
    ) uof ON (uof.sales_order_no = sf.order_number AND sf.branch_id = uof.branch_id)
    LEFT JOIN dim_branch bd ON sf.branch_id = bd.branch_id 
    LEFT JOIN dim_digital_channel doc ON (doc.ent_type = uof.ent_type AND doc.datasource_num_id = sf.datasource_num_id) 
    LEFT JOIN ref_datasource dt ON dt.datasource_num_id = sf.datasource_num_id 
    LEFT JOIN dim_customer cus ON sf.customer_dim_key = cus.customer_dim_key 
    LEFT JOIN ref_conversion_rates cr ON (cr.from_currency = sf.currency AND cr.to_currency = 'USD' AND year(sf.date_invoice) = cr.cnv_year AND month(sf.date_invoice) = cr.cnv_month)
    WHERE sf.datasource_num_id = 13000 AND coalesce(cus.intercompany_customer, 'N') = 'N' AND sf.accounting_include_flag = 'Y' AND coalesce(sf.sales_transfer_flag, 'N') <> 'Y' AND coalesce(sf.kit_component_flag, 'N') <> 'C'
    GROUP BY sf.datasource_num_id, uof.ent_type, bd.sbu, doc.rollup_category, sf.date_invoice, sf.currency, cus.customer_name, cus.customer_no, sf.invoice_no, sf.order_number, dt.datasource_description, cr.conversion_rate
    HAVING SUM(CAST(sf.sales_amount AS DECIMAL(38,2))) <> 0

    UNION ALL

    -- 5. EECOL (11000)
    SELECT sf.datasource_num_id, bd.sbu, uof.ent_type, doc.rollup_category, sf.date_invoice, count(distinct sf.order_number) as total_no_of_sales, SUM(CAST(sf.sales_amount AS DECIMAL(38,2))) as sales_amount, sf.currency, dt.datasource_description as data_source_name, concat(cus.customer_no, '_', cus.customer_name) as cust_name, sf.invoice_no, sf.order_number, 
    CAST(coalesce(CASE WHEN sf.currency = 'USD' THEN 1 ELSE cr.conversion_rate END, 1) AS DECIMAL(18,6)) as currency_conversion, 
    CAST(CAST(SUM(sf.sales_amount) AS DECIMAL(38,2)) * coalesce(CASE WHEN sf.currency = 'USD' THEN 1 ELSE cr.conversion_rate END, 1) AS DECIMAL(38,12)) as sales_amount_USD, 
    current_date() as CREATE_DATE
    FROM sf_sales_fact sf
    LEFT JOIN (
        SELECT TRIM(ent_type) AS ent_type, TRIM(sales_order_no) AS sales_order_no, TRIM(branch_id) as branch_id, TRIM(CAST(WesnetLine AS STRING)) AS WesnetLine 
        FROM (SELECT ent_type, sales_order_no, branch_id, WesnetLine, ROW_NUMBER() OVER (PARTITION BY datasource_num_id, TRY_CAST(TRIM(sales_order_no) AS DECIMAL(38,0)), TRIM(branch_id), TRY_CAST(TRIM(CAST(WesnetLine AS STRING)) AS DECIMAL(38,0)) ORDER BY CASE WHEN TRIM(ent_type) IS NOT NULL AND TRIM(ent_type) <> '' THEN 0 ELSE 1 END, order_updated_ts DESC, dl_load_date DESC) AS rn FROM brz_teradata.udm_order_fact WHERE datasource_num_id = 11000) WHERE rn = 1
    ) uof ON (TRY_CAST(uof.sales_order_no AS DECIMAL(38,0)) = TRY_CAST(sf.order_number AS DECIMAL(38,0)) AND sf.branch_id = uof.branch_id AND TRY_CAST(uof.WesnetLine AS DECIMAL(38,0)) = TRY_CAST(CAST(sf.invoice_line_no AS STRING) AS DECIMAL(38,0)))
    LEFT JOIN dim_branch bd ON sf.branch_id = bd.branch_id 
    LEFT JOIN dim_digital_channel doc ON (REGEXP_REPLACE(doc.ent_type, '       ', '') = uof.ent_type AND doc.datasource_num_id = sf.datasource_num_id) 
    LEFT JOIN ref_datasource dt ON dt.datasource_num_id = sf.datasource_num_id 
    LEFT JOIN dim_customer cus ON sf.customer_dim_key = cus.customer_dim_key 
    LEFT JOIN ref_conversion_rates cr ON (cr.from_currency = sf.currency AND cr.to_currency = 'USD' AND year(sf.date_invoice) = cr.cnv_year AND month(sf.date_invoice) = cr.cnv_month)
    WHERE sf.datasource_num_id = 11000 AND coalesce(cus.intercompany_customer, 'N') = 'N'
    GROUP BY sf.datasource_num_id, uof.ent_type, bd.sbu, doc.rollup_category, sf.date_invoice, sf.currency, cus.customer_name, cus.customer_no, sf.invoice_no, sf.order_number, dt.datasource_description, cr.conversion_rate
    HAVING SUM(CAST(sf.sales_amount AS DECIMAL(38,2))) <> 0

    UNION ALL

    -- 6. Hazmasters (14000)
    SELECT sf.datasource_num_id, bd.sbu, uof.ent_type, doc.rollup_category, sf.date_invoice, count(distinct sf.order_number) as total_no_of_sales, SUM(CAST(sf.sales_amount AS DECIMAL(38,2))) as sales_amount, sf.currency, dt.datasource_description as data_source_name, concat(cus.customer_no, '_', cus.customer_name) as cust_name, sf.invoice_no, sf.order_number, 
    CAST(coalesce(CASE WHEN sf.currency = 'USD' THEN 1 ELSE cr.conversion_rate END, 1) AS DECIMAL(18,6)) as currency_conversion, 
    CAST(CAST(SUM(sf.sales_amount) AS DECIMAL(38,2)) * coalesce(CASE WHEN sf.currency = 'USD' THEN 1 ELSE cr.conversion_rate END, 1) AS DECIMAL(38,12)) as sales_amount_USD, 
    current_date() as CREATE_DATE
    FROM sf_sales_fact sf
    LEFT JOIN (
        SELECT TRIM(ent_type) AS ent_type, TRIM(sales_order_no) AS sales_order_no, TRIM(branch_id) as branch_id
        FROM (SELECT ent_type, sales_order_no, branch_id, ROW_NUMBER() OVER (PARTITION BY datasource_num_id, TRIM(sales_order_no), TRIM(branch_id) ORDER BY CASE WHEN TRIM(ent_type) IS NOT NULL AND TRIM(ent_type) <> '' THEN 0 ELSE 1 END, order_updated_ts DESC, dl_load_date DESC) AS rn FROM brz_teradata.udm_order_fact WHERE datasource_num_id = 14000) WHERE rn = 1
    ) uof ON (uof.sales_order_no = sf.order_number AND sf.branch_id = uof.branch_id)
    LEFT JOIN dim_branch bd ON sf.branch_id = bd.branch_id 
    LEFT JOIN dim_digital_channel doc ON (doc.ent_type = uof.ent_type AND doc.datasource_num_id = sf.datasource_num_id) 
    LEFT JOIN ref_datasource dt ON dt.datasource_num_id = sf.datasource_num_id 
    LEFT JOIN dim_customer cus ON sf.customer_dim_key = cus.customer_dim_key 
    LEFT JOIN ref_conversion_rates cr ON (cr.from_currency = sf.currency AND cr.to_currency = 'USD' AND year(sf.date_invoice) = cr.cnv_year AND month(sf.date_invoice) = cr.cnv_month)
    WHERE sf.datasource_num_id = 14000 AND sf.accounting_include_flag = 'Y' AND coalesce(sf.sales_transfer_flag, 'N') <> 'Y' AND coalesce(sf.kit_component_flag, 'N') <> 'C'
    GROUP BY sf.datasource_num_id, uof.ent_type, bd.sbu, doc.rollup_category, sf.date_invoice, sf.currency, cus.customer_name, cus.customer_no, sf.invoice_no, sf.order_number, dt.datasource_description, cr.conversion_rate
    HAVING SUM(CAST(sf.sales_amount AS DECIMAL(38,2))) <> 0

    UNION ALL

    -- 7. WIS (10000)
    SELECT sf.datasource_num_id, bd.sbu, coalesce(uof.ent_type, 'e-Crib') as ent_type, coalesce(doc.rollup_category, 'Materials Management') as rollup_category, sf.date_invoice, count(distinct sf.order_number) as total_no_of_sales, SUM(CAST(sf.sales_amount AS DECIMAL(38,2))) as sales_amount, sf.currency, dt.datasource_description as data_source_name, concat(cus.customer_no, '_', cus.customer_name) as cust_name, sf.invoice_no, sf.order_number, 
    CAST(coalesce(CASE WHEN sf.currency = 'USD' THEN 1 ELSE cr.conversion_rate END, 1) AS DECIMAL(18,6)) as currency_conversion, 
    CAST(CAST(SUM(sf.sales_amount) AS DECIMAL(38,2)) * coalesce(CASE WHEN sf.currency = 'USD' THEN 1 ELSE cr.conversion_rate END, 1) AS DECIMAL(38,12)) as sales_amount_USD, 
    current_date() as CREATE_DATE

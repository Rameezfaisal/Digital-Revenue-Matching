# 1. WESNET (3000)
df_wesnet = spark.sql(f"""
SELECT sf.datasource_num_id,
  (SELECT bd.sbu FROM {source_schema}.branch_dim bd WHERE sf.branch_id = bd.branch_id LIMIT 1) as sbu,
  uof.flex_1 as ent_type,
  (SELECT doc.rollup_category FROM {source_schema}.udm_digital_channel_code_dim doc 
   WHERE doc.ent_type = uof.flex_1 AND doc.datasource_num_id = uof.datasource_num_id LIMIT 1) as rollup_category,
  sf.date_invoice, 
  count(*) as total_no_of_sales,
  sum(sf.sales_amount) as sales_amount,
  sf.currency,
  (SELECT dt.datasource_description FROM {source_schema}.datasource_tbl dt WHERE dt.datasource_num_id = sf.datasource_num_id LIMIT 1) as data_source_name,
  concat(cus.customer_no, '_', cus.customer_name) as cust_name,
  sf.invoice_no,
  sf.wesnet_order_no as order_number,
  CASE WHEN sf.currency = 'USD' THEN 1
       ELSE (SELECT conversion_rate FROM {source_schema}.ora_conv_rates_mthly curr_conv 
             WHERE curr_conv.from_currency = sf.currency AND curr_conv.to_currency = 'USD' 
             AND year(sf.date_invoice) = curr_conv.cnv_year AND month(sf.date_invoice) = curr_conv.cnv_month LIMIT 1) 
  END as currency_conversion,
  (cast(sum(sf.sales_amount) as DECIMAL(38,2)) * 
   CASE WHEN sf.currency = 'USD' THEN 1 ELSE (SELECT conversion_rate FROM {source_schema}.ora_conv_rates_mthly curr_conv WHERE curr_conv.from_currency = sf.currency AND curr_conv.to_currency = 'USD' AND year(sf.date_invoice) = curr_conv.cnv_year AND month(sf.date_invoice) = curr_conv.cnv_month LIMIT 1) END
  ) as sales_amount_USD,
  current_date() as CREATE_DATE
FROM {source_schema}.udm_sales_fact sf
LEFT OUTER JOIN (SELECT distinct sales_order_no, branch_id, datasource_num_id, order_integration_id, flex_1 FROM {source_schema}.udm_order_fact) uof
  ON (uof.sales_order_no = sf.wesnet_order_no AND uof.datasource_num_id = sf.datasource_num_id AND uof.branch_id = sf.branch_id AND uof.order_integration_id = sf.order_integration_id)
LEFT OUTER JOIN {source_schema}.udm_customer_dim cus ON sf.customer_dim_key = cus.customer_dim_key
WHERE sf.datasource_num_id = 3000 
  AND sf.date_invoice > (SELECT max_date_loaded FROM v_view_load WHERE datasource_num_id = 3000) 
  AND sf.date_invoice < trunc(current_date(), 'MM')
  AND sf.accounting_include_flag = 'Y'
  AND coalesce(sf.sales_transfer_flag, 'N') <> 'Y'
  AND coalesce(sf.kit_component_flag, 'N') <> 'C'
  AND left(cus.customer_no, 1) <> 'X'
  AND sf.sim_description <> 'Datacom Redaction'
  AND coalesce(sf.inventory_org_code, '') <> 'SCS'
  AND (sf.sales_amount <> 0 OR sf.cost_amount <> 0 OR sf.quantity <> 0 OR sf.market_cost <> 0)
  AND sf.transaction_type <> 'X99'
GROUP BY sf.datasource_num_id, uof.flex_1, sbu, rollup_category, sf.date_invoice, sf.currency, 
         cus.customer_name, cus.customer_no, sf.invoice_no, sf.wesnet_order_no, data_source_name, currency_conversion
HAVING sum(sf.sales_amount) <> 0
""")


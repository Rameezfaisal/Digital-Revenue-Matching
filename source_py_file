SELECT 
    datasource_num_id, 
    branch_id, 
    date_invoice, 
    invoice_no, 
    order_number,
    LENGTH(branch_id) AS len_branch,
    LENGTH(invoice_no) AS len_invoice,
    LENGTH(order_number) AS len_order
FROM brz_teradata.udm_sales_fact
WHERE invoice_no = '24F206518' 
  AND datasource_num_id = 12004;





SELECT 
    datasource_num_id, 
    branch_id, 
    date_invoice, 
    invoice_no, 
    sales_order_no,
    ent_type,
    LENGTH(branch_id) AS len_branch,
    LENGTH(invoice_no) AS len_invoice,
    LENGTH(sales_order_no) AS len_order
FROM brz_teradata.udm_order_fact
WHERE sales_order_no = '24FB24GP' 
  AND datasource_num_id = 12004;





SELECT 
    sf.invoice_no AS sf_invoice,
    uof.invoice_no AS uof_invoice,
    sf.date_invoice AS sf_date,
    uof.date_invoice AS uof_date,
    sf.branch_id AS sf_branch,
    uof.branch_id AS uof_branch,
    uof.ent_type
FROM brz_teradata.udm_sales_fact sf
LEFT JOIN brz_teradata.udm_order_fact uof 
    ON sf.datasource_num_id = uof.datasource_num_id
    AND sf.order_number = uof.sales_order_no
WHERE sf.invoice_no = '24F206518' 
  AND sf.datasource_num_id = 12004;






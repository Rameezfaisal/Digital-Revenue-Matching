# DBTITLE 1,Build Live Bronze Deduplicated Views
spark.sql("""
CREATE OR REPLACE TEMPORARY VIEW max_loaded_per_ds AS
SELECT datasource_num_id, MAX(to_date(date_invoice)) AS max_date_loaded
FROM gld_eudm.digital_dashboard_control
GROUP BY datasource_num_id
""")

# Replicate Teradata Step 3 date filters: > '2021-12-31' and <= max_date_loaded and <> current month
spark.sql("""
CREATE OR REPLACE TEMPORARY VIEW sf_sales_fact AS
SELECT * FROM (
    SELECT 
        sf.datasource_num_id, TRIM(sf.branch_id) AS branch_id, to_date(sf.date_invoice) AS date_invoice,
        sf.sales_amount, TRIM(sf.currency) AS currency, sf.customer_dim_key, TRIM(sf.invoice_no) AS invoice_no,
        TRIM(sf.wesnet_order_no) AS wesnet_order_no, TRIM(sf.order_number) AS order_number,
        TRIM(sf.order_integration_id) AS order_integration_id, TRIM(sf.accounting_include_flag) AS accounting_include_flag,
        TRIM(sf.sales_transfer_flag) AS sales_transfer_flag, TRIM(sf.kit_component_flag) AS kit_component_flag,
        TRIM(sf.sim_description) AS sim_description, TRIM(sf.inventory_org_code) AS inventory_org_code,
        sf.cost_amount, sf.quantity, sf.market_cost, TRIM(sf.transaction_type) AS transaction_type,
        sf.invoice_line_no, sf.conversion_rate, sf.budget_conversion_rate, TRIM(sf.flex_1) AS flex_1,
        sf.dl_load_date, sf.updated_ts,
        RANK() OVER (
            PARTITION BY sf.datasource_num_id, TRIM(sf.invoice_no), TRIM(sf.order_number), TRIM(sf.branch_id),
            COALESCE(CAST(sf.invoice_line_no AS STRING), concat(CAST(sf.sales_amount AS STRING), CAST(sf.quantity AS STRING)))
            ORDER BY sf.updated_ts DESC, sf.dl_load_date DESC
        ) AS rnk
    FROM brz_teradata.udm_sales_fact sf
    LEFT JOIN max_loaded_per_ds ml ON sf.datasource_num_id = ml.datasource_num_id
    WHERE sf.datasource_num_id IN (3000, 4000, 5000, 6000, 7000, 8000, 9000, 10000, 11000, 12001, 12002, 12003, 12004, 12005, 13000, 14000)
      AND to_date(sf.date_invoice) > DATE '2021-12-31'
      AND to_date(sf.date_invoice) <= COALESCE(ml.max_date_loaded, DATE '2021-12-31')
      AND date_format(sf.date_invoice, 'yyyy-MM') <> date_format(current_date(), 'yyyy-MM')
) WHERE rnk = 1
""")

spark.sql("""
CREATE OR REPLACE TEMPORARY VIEW dim_customer AS
SELECT customer_dim_key, TRIM(customer_no) AS customer_no, TRIM(customer_name) AS customer_name, TRIM(intercompany_customer) AS intercompany_customer, TRIM(national_acct_no) AS national_acct_no
FROM (SELECT *, ROW_NUMBER() OVER (PARTITION BY customer_dim_key ORDER BY updated_ts DESC, dl_load_date DESC) AS rn FROM brz_teradata.udm_customer_dim) WHERE rn = 1
""")

spark.sql("""
CREATE OR REPLACE TEMPORARY VIEW dim_branch AS
SELECT TRIM(branch_id) AS branch_id, TRIM(sbu) AS sbu FROM (SELECT *, ROW_NUMBER() OVER (PARTITION BY TRIM(branch_id) ORDER BY updated_ts DESC, dl_load_date DESC) AS rn FROM brz_teradata.branch_dim) WHERE rn = 1
""")

spark.sql("""
CREATE OR REPLACE TEMPORARY VIEW dim_digital_channel AS
SELECT TRIM(ent_type) AS ent_type, datasource_num_id, TRIM(rollup_category) AS rollup_category FROM (SELECT ent_type, datasource_num_id, rollup_category, ROW_NUMBER() OVER (PARTITION BY TRIM(ent_type), datasource_num_id ORDER BY updated_ts DESC, dl_load_date DESC) AS rn FROM brz_teradata.udm_digital_channel_code_dim) WHERE rn = 1
""")

spark.sql("""
CREATE OR REPLACE TEMPORARY VIEW ref_datasource AS
SELECT datasource_num_id, TRIM(datasource_description) AS datasource_description, TRIM(datasource_name) AS datasource_name FROM (SELECT datasource_num_id, datasource_description, datasource_name, ROW_NUMBER() OVER (PARTITION BY datasource_num_id ORDER BY dl_load_date DESC) AS rn FROM brz_teradata.datasource_tbl) WHERE rn = 1
""")

spark.sql("""
CREATE OR REPLACE TEMPORARY VIEW ref_conversion_rates AS SELECT DISTINCT TRIM(from_currency) AS from_currency, TRIM(to_currency) AS to_currency, cnv_year, cnv_month, conversion_rate FROM brz_by_teradata.ora_conv_rates_mthly
""")

spark.sql("""
CREATE OR REPLACE TEMPORARY VIEW anixter_conv_rates AS SELECT TRIM(FROM_CURR_C) AS FROM_CURR_C, TRIM(rate_type) AS rate_type, FISCAL_YY_D, FISCAL_MM_D, CURR_CONV_ACTUAL_F FROM (SELECT FROM_CURR_C, rate_type, FISCAL_YY_D, FISCAL_MM_D, CURR_CONV_ACTUAL_F, ROW_NUMBER() OVER (PARTITION BY TRIM(FROM_CURR_C), TRIM(rate_type), FISCAL_YY_D, FISCAL_MM_D ORDER BY dl_load_date DESC) AS rn FROM brz_teradata.anixter_monthly_conversion_rate_tbl) WHERE rn = 1
""")


    COUNT(*) AS total_raw_rows,
    COUNT(DISTINCT datasource_num_id, invoice_no, order_number, branch_id) AS deduped_without_line_no,
    COUNT(DISTINCT datasource_num_id, invoice_no, invoice_line_no, order_number, branch_id) AS deduped_with_line_no
FROM brz_teradata.udm_sales_fact
WHERE datasource_num_id = 3000 
AND YEAR(date_invoice) = 2022;





%sql
SELECT 
    sbu,
    ent_type,
    rollup_category,
    COUNT(*) AS row_cnt,
    ROUND(SUM(sales_amount_USD), 2) AS total_usd
FROM gld_eudm.digital_dashboard_control
WHERE datasource_num_id = 3000
  AND sbu = 'EES'
  AND date_invoice BETWEEN '2025-05-01' AND '2025-05-31'
GROUP BY sbu, ent_type, rollup_category
ORDER BY total_usd DESC;





%sql
SELECT 
    flex_1,
    COUNT(*) AS raw_rows
FROM brz_teradata.udm_order_fact
WHERE datasource_num_id = 3000
GROUP BY flex_1
ORDER BY raw_rows DESC
LIMIT 20;





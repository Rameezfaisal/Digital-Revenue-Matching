COMMAND ----------
--> The below code performs a merge operation between selected source data with the target data
--> CDC:- The incremental logic selects the data where the modifyts of source table is greater than the target execution date
--> Deduplication handles selecting the latest records
--> Merges on composite key: datasource_num_id, invoice_no, order_number
try:
spark.sql(f"""MERGE INTO gld_eudm.digital_dashboard_control as t
USING (
SELECT * FROM final_df
) as s
ON t.datasource_num_id = s.datasource_num_id
AND t.invoice_no = s.invoice_no
AND t.order_number = s.order_number
AND t.date_invoice = s.date_invoice  /comparing merge keys/
WHEN MATCHED THEN
UPDATE SET
sbu = s.sbu,
ent_type = s.ent_type,
rollup_category = s.rollup_category,
total_no_of_sales = s.total_no_of_sales,
sales_amount = s.sales_amount,
currency = s.currency,
data_source_name = s.data_source_name,
cust_name = s.cust_name,
currency_conversion = s.currency_conversion,
sales_amount_USD = s.sales_amount_USD,
CREATE_DATE = s.CREATE_DATE
WHEN NOT MATCHED THEN
INSERT (
datasource_num_id,
sbu,
ent_type,
rollup_category,
date_invoice,
total_no_of_sales,
sales_amount,
currency,
data_source_name,
cust_name,
invoice_no,
order_number,
currency_conversion,
sales_amount_USD,
CREATE_DATE
)
VALUES (
s.datasource_num_id,
s.sbu,
s.ent_type,
s.rollup_category,
s.date_invoice,
s.total_no_of_sales,
s.sales_amount,
s.currency,
s.data_source_name,
s.cust_name,
s.invoice_no,
s.order_number,
s.currency_conversion,
s.sales_amount_USD,
s.CREATE_DATE
)
""")

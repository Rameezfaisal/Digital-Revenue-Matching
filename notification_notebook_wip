def send_smtp_email(subject, body, recipients):
    """Utility function to send emails securely via Office365 SMTP."""
    msg = MIMEMultipart()
    msg['From'] = SENDER_EMAIL
    msg['To'] = ", ".join(recipients)
    msg['Subject'] = subject

    msg.attach(MIMEText(body, 'plain'))

    try:
        # Create a secure SSL context and authenticate just like the reference script
        ctx = ssl.create_default_context()
        with smtplib.SMTP(SMTP_HOST, SMTP_PORT, timeout=30) as s:
            s.ehlo()
            s.starttls(context=ctx)
            s.ehlo()
            s.login(SMTP_USER, SMTP_PASS)
            s.sendmail(SENDER_EMAIL, recipients, msg.as_string())
            
        print(f"Email sent successfully to {', '.join(recipients)}")
    except Exception as e:
        print(f"Failed to send email via SMTP: {str(e)}")
        raise e

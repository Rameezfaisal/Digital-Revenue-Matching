# Replicate Teradata's udm_view_load watermark per datasource_num_id
spark.sql("""
CREATE OR REPLACE TEMPORARY VIEW max_loaded_per_ds AS
SELECT 
    datasource_num_id, 
    MAX(to_date(date_invoice)) AS max_date_loaded
FROM gld_eudm.digital_dashboard_control
GROUP BY datasource_num_id
""")

spark.sql("""
CREATE OR REPLACE TEMPORARY VIEW sf_sales_fact AS
SELECT * FROM (
    SELECT 
        sf.datasource_num_id,
        TRIM(sf.branch_id) AS branch_id,
        to_date(sf.date_invoice) AS date_invoice,
        sf.sales_amount,
        TRIM(sf.currency) AS currency,
        sf.customer_dim_key,
        TRIM(sf.invoice_no) AS invoice_no,
        TRIM(sf.wesnet_order_no) AS wesnet_order_no,
        TRIM(sf.order_number) AS order_number,
        TRIM(sf.order_integration_id) AS order_integration_id,
        TRIM(sf.accounting_include_flag) AS accounting_include_flag,
        TRIM(sf.sales_transfer_flag) AS sales_transfer_flag,
        TRIM(sf.kit_component_flag) AS kit_component_flag,
        TRIM(sf.sim_description) AS sim_description,
        TRIM(sf.inventory_org_code) AS inventory_org_code,
        sf.cost_amount,
        sf.quantity,
        sf.market_cost,
        TRIM(sf.transaction_type) AS transaction_type,
        sf.invoice_line_no,
        sf.conversion_rate,
        sf.budget_conversion_rate,
        TRIM(sf.flex_1) AS flex_1,
        sf.dl_load_date,
        sf.updated_ts,
        RANK() OVER (
            PARTITION BY 
                sf.datasource_num_id, 
                TRIM(sf.invoice_no), 
                TRIM(sf.order_number), 
                TRIM(sf.branch_id),
                COALESCE(CAST(sf.invoice_line_no AS STRING), concat(CAST(sf.sales_amount AS STRING), CAST(sf.quantity AS STRING)))
            ORDER BY sf.updated_ts DESC, sf.dl_load_date DESC
        ) AS rnk
    FROM brz_teradata.udm_sales_fact sf
    LEFT JOIN max_loaded_per_ds ml 
        ON sf.datasource_num_id = ml.datasource_num_id
    WHERE sf.datasource_num_id IN (3000, 4000, 5000, 6000, 7000, 8000, 9000, 10000, 11000, 12001, 12002, 12003, 12004, 12005, 13000, 14000)
      AND to_date(sf.date_invoice) >= DATE '2024-01-01'
      AND to_date(sf.date_invoice) > COALESCE(ml.max_date_loaded, DATE '2023-12-31')
      AND to_date(sf.date_invoice) < trunc(current_date(), 'MM')
)
WHERE rnk = 1
""")

# COMMAND ----------
spark.sql("""
CREATE OR REPLACE TEMPORARY VIEW dim_customer AS
SELECT 
    customer_dim_key,
    TRIM(customer_no) AS customer_no,
    TRIM(customer_name) AS customer_name,
    TRIM(intercompany_customer) AS intercompany_customer,
    TRIM(national_acct_no) AS national_acct_no,
    dl_load_date,
    updated_ts
FROM (
    SELECT *,
        ROW_NUMBER() OVER (
            PARTITION BY customer_dim_key
            ORDER BY updated_ts DESC, dl_load_date DESC
        ) AS row_num
    FROM brz_teradata.udm_customer_dim
) t
WHERE row_num = 1
""")

# COMMAND ----------
spark.sql("""
CREATE OR REPLACE TEMPORARY VIEW dim_branch AS
SELECT 
    TRIM(branch_id) AS branch_id,
    TRIM(sbu) AS sbu,
    updated_ts
FROM (
    SELECT *,
        ROW_NUMBER() OVER (
            PARTITION BY TRIM(branch_id)
            ORDER BY updated_ts DESC, dl_load_date DESC
        ) AS row_num
    FROM brz_teradata.branch_dim
) t
WHERE row_num = 1
""")

# COMMAND ----------
spark.sql("""
CREATE OR REPLACE TEMPORARY VIEW dim_digital_channel AS
SELECT 
    TRIM(ent_type) AS ent_type,
    datasource_num_id,
    TRIM(rollup_category) AS rollup_category
FROM (
    SELECT 
        ent_type,
        datasource_num_id,
        rollup_category,
        ROW_NUMBER() OVER (
            PARTITION BY TRIM(ent_type), datasource_num_id
            ORDER BY updated_ts DESC, dl_load_date DESC
        ) AS rn
    FROM brz_teradata.udm_digital_channel_code_dim
) t
WHERE rn = 1
""")

# COMMAND ----------
spark.sql("""
CREATE OR REPLACE TEMPORARY VIEW ref_datasource AS
SELECT 
    datasource_num_id,
    TRIM(datasource_description) AS datasource_description,
    TRIM(datasource_name) AS datasource_name
FROM (
    SELECT 
        datasource_num_id,
        datasource_description,
        datasource_name,
        ROW_NUMBER() OVER (
            PARTITION BY datasource_num_id
            ORDER BY dl_load_date DESC
        ) AS rn
    FROM brz_teradata.datasource_tbl
) t
WHERE rn = 1
""")

# COMMAND ----------
spark.sql("""
CREATE OR REPLACE TEMPORARY VIEW ref_conversion_rates AS
SELECT DISTINCT
    TRIM(from_currency) AS from_currency,
    TRIM(to_currency) AS to_currency,
    cnv_year,
    cnv_month,
    conversion_rate
FROM brz_by_teradata.ora_conv_rates_mthly
""")

spark.sql("""
CREATE OR REPLACE TEMPORARY VIEW anixter_conv_rates AS
SELECT 
    TRIM(FROM_CURR_C) AS FROM_CURR_C,
    TRIM(rate_type) AS rate_type,
    FISCAL_YY_D,
    FISCAL_MM_D,
    CURR_CONV_ACTUAL_F
FROM (
    SELECT 
        FROM_CURR_C,
        rate_type,
        FISCAL_YY_D,
        FISCAL_MM_D,
        CURR_CONV_ACTUAL_F,
        ROW_NUMBER() OVER (
            PARTITION BY TRIM(FROM_CURR_C), TRIM(rate_type), FISCAL_YY_D, FISCAL_MM_D
            ORDER BY dl_load_date DESC
        ) AS rn
    FROM brz_teradata.anixter_monthly_conversion_rate_tbl
) t
WHERE rn = 1
""")

# COMMAND ----------
main_df = spark.sql("""
WITH base_incremental_sales AS (
    SELECT * FROM sf_sales_fact
    WHERE date_invoice < trunc(current_date(), 'MM')
)
SELECT * FROM (

    -- 1. WESNET (3000)
    SELECT 
        sf.datasource_num_id,
        bd.sbu,
        uof.flex_1 AS ent_type,
        doc.rollup_category,
        sf.date_invoice,
        count(*) AS total_no_of_sales,
        SUM(CAST(sf.sales_amount AS DECIMAL(38,2))) AS sales_amount,
        sf.currency,
        dt.datasource_description AS data_source_name,
        concat(cus.customer_no, '_', cus.customer_name) AS cust_name,
        sf.invoice_no,
        sf.wesnet_order_no AS order_number,
        CAST(coalesce(CASE WHEN sf.currency = 'USD' THEN 1 ELSE cr.conversion_rate END, 1) AS DECIMAL(18,6)) AS currency_conversion,
        CAST(CAST(SUM(sf.sales_amount) AS DECIMAL(38,2)) * coalesce(CASE WHEN sf.currency = 'USD' THEN 1 ELSE cr.conversion_rate END, 1) AS DECIMAL(38,12)) AS sales_amount_USD,
        current_date() AS CREATE_DATE
    FROM base_incremental_sales sf
    LEFT JOIN (
        SELECT 
            TRIM(sales_order_no) AS sales_order_no,
            TRIM(branch_id) AS branch_id,
            datasource_num_id,
            TRIM(order_integration_id) AS order_integration_id,
            TRIM(flex_1) AS flex_1
        FROM (
            SELECT 
                sales_order_no, branch_id, datasource_num_id, order_integration_id, flex_1,
                ROW_NUMBER() OVER (
                    PARTITION BY datasource_num_id, TRIM(sales_order_no), TRIM(branch_id), TRIM(order_integration_id)
                    ORDER BY CASE WHEN TRIM(flex_1) IS NOT NULL AND TRIM(flex_1) <> '' THEN 0 ELSE 1 END,
                             order_updated_ts DESC, dl_load_date DESC
                ) AS rn
            FROM brz_teradata.udm_order_fact
            WHERE datasource_num_id = 3000
        ) WHERE rn = 1
    ) uof ON (
        uof.sales_order_no = sf.wesnet_order_no
        AND CAST(uof.datasource_num_id AS INT) = CAST(sf.datasource_num_id AS INT)
        AND uof.branch_id = sf.branch_id
        AND uof.order_integration_id = sf.order_integration_id
    )
    LEFT JOIN dim_branch bd ON sf.branch_id = bd.branch_id
    LEFT JOIN dim_digital_channel doc ON (doc.ent_type = uof.flex_1 AND doc.datasource_num_id = uof.datasource_num_id)
    LEFT JOIN ref_datasource dt ON dt.datasource_num_id = sf.datasource_num_id
    LEFT JOIN dim_customer cus ON sf.customer_dim_key = cus.customer_dim_key
    LEFT JOIN ref_conversion_rates cr ON (cr.from_currency = sf.currency AND cr.to_currency = 'USD' AND year(sf.date_invoice) = cr.cnv_year AND month(sf.date_invoice) = cr.cnv_month)
    WHERE sf.datasource_num_id = 3000
      AND sf.accounting_include_flag = 'Y'
      AND coalesce(sf.sales_transfer_flag, 'N') <> 'Y'
      AND coalesce(sf.kit_component_flag, 'N') <> 'C'
      AND left(cus.customer_no, 1) <> 'X'
      AND sf.sim_description <> 'Datacom Redaction'
      AND coalesce(sf.inventory_org_code, '') <> 'SCS'
      AND (sf.sales_amount <> 0 OR sf.cost_amount <> 0 OR sf.quantity <> 0 OR sf.market_cost <> 0)
      AND sf.transaction_type <> 'X99'
    GROUP BY sf.datasource_num_id, uof.flex_1, bd.sbu, doc.rollup_category, sf.date_invoice, sf.currency, cus.customer_name, cus.customer_no, sf.invoice_no, sf.wesnet_order_no, dt.datasource_description, cr.conversion_rate

    ) uof ON (
        TRIM(REGEXP_REPLACE(CAST(uof.sales_order_no AS STRING), '\\.0+$', '')) = TRIM(REGEXP_REPLACE(CAST(sf.order_number AS STRING), '\\.0+$', '')) 
        AND TRIM(CAST(sf.branch_id AS STRING)) = TRIM(CAST(uof.branch_id AS STRING)) 
        AND TRIM(REGEXP_REPLACE(CAST(uof.WesnetLine AS STRING), '\\.0+$', '')) = TRIM(REGEXP_REPLACE(CAST(sf.invoice_line_no AS STRING), '\\.0+$', ''))
    )

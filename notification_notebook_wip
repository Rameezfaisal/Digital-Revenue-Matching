# 2. Safely parse the email string into a list (borrowed from reference notebook logic)
EMAIL_SPLIT = re.compile(r"[;,]")

def split_emails(val):
    """Splits a string of emails separated by commas or semicolons into a clean list."""
    if not isinstance(val, str):
        return []
    parts = EMAIL_SPLIT.split(val)
    out = []
    for e in parts:
        s = e.strip()
        if s:
            out.append(s)
    return out


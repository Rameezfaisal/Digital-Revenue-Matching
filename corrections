    LEFT JOIN (
        SELECT 
        TRIM(sales_order_no) AS sales_order_no, 
        TRIM(branch_id) as branch_id, 
        datasource_num_id, 
        order_integration_id, 
        TRIM(flex_1) AS flex_1
        FROM (
            SELECT sales_order_no, branch_id, datasource_num_id, order_integration_id, flex_1,
                   ROW_NUMBER() OVER (PARTITION BY datasource_num_id,trim(sales_order_no), trim(branch_id), order_integration_id ORDER BY CASE WHEN TRIM(flex_1) is not null and trim(flex_1) <> '' then 0 else 1 end, order_updated_ts DESC, dl_load_date DESC) AS rn
            FROM brz_teradata.udm_order_fact
            WHERE datasource_num_id = 3000
        ) WHERE rn = 1
    ) uof ON (
        TRIM(CAST(uof.sales_order_no AS STRING)) = TRIM(CAST(sf.wesnet_order_no AS STRING))
        AND CAST(uof.datasource_num_id AS INT) = CAST(sf.datasource_num_id AS INT) 
        AND TRIM(CAST(uof.branch_id AS STRING)) = TRIM(CAST(sf.branch_id AS STRING)) 
        AND TRIM(CAST(uof.order_integration_id AS STRING)) = TRIM(CAST(sf.order_integration_id AS STRING))
    )
    LEFT JOIN dim_branch bd ON sf.branch_id = bd.branch_id 

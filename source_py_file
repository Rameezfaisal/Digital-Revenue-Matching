# MAGIC %sql
# MAGIC -- Create the view by aggregating the deduplicated silver/gold table. 
# MAGIC -- The current month is excluded to match the legacy Teradata script's logic.
# MAGIC
# MAGIC CREATE OR REPLACE VIEW gld_eudm.vw_digital_revenue_dashboard AS
# MAGIC WITH latest_dashboard_control AS (
# MAGIC     SELECT * FROM (
# MAGIC         SELECT *,
# MAGIC             row_number() OVER (
# MAGIC                 PARTITION BY datasource_num_id, invoice_no, order_number, date_invoice, ent_type, rollup_category, currency
# MAGIC                 ORDER BY dl_updated_ts DESC
# MAGIC             ) as dedup_row
# MAGIC         FROM gld_eudm.digital_dashboard_control
# MAGIC     )
# MAGIC     WHERE dedup_row = 1
# MAGIC )
# MAGIC SELECT 
# MAGIC     datasource_num_id,
# MAGIC     rollup_category,
# MAGIC     date_format(date_invoice, 'yyyy-MM') AS month_of_year,
# MAGIC     SUM(sales_amount) AS total_sales_amount,
# MAGIC     SUM(sales_amount_usd) AS total_sales_amount_usd
# MAGIC FROM latest_dashboard_control
# MAGIC WHERE date_format(date_invoice, 'yyyy-MM') <> date_format(current_date(), 'yyyy-MM')
# MAGIC GROUP BY 
# MAGIC     datasource_num_id,
# MAGIC     rollup_category,
# MAGIC     date_format(date_invoice, 'yyyy-MM');

# COMMAND ----------

mismatch_df = spark.sql("""
    -- 1. Find records in the recalculated view that are NOT in the physical summary table
    (
        SELECT 
            datasource_num_id,
            rollup_category,
            month_of_year,
            total_sales_amount,
            total_sales_amount_usd
        FROM gld_eudm.vw_digital_revenue_dashboard

        EXCEPT

        SELECT 
            datasource_num_id,
            rollup_category,
            month_of_year,
            sales_amount AS total_sales_amount,
            sales_amount_usd AS total_sales_amount_usd
        FROM gld_eudm.digital_dashboard_control_summary
        WHERE month_of_year <> date_format(current_date(), 'yyyy-MM')
    )
    
    UNION ALL

    -- 2. Find records in the physical summary table that are NOT in the recalculated view
    (
        SELECT 
            datasource_num_id,
            rollup_category,
            month_of_year,
            sales_amount AS total_sales_amount,
            sales_amount_usd AS total_sales_amount_usd
        FROM gld_eudm.digital_dashboard_control_summary
        WHERE month_of_year <> date_format(current_date(), 'yyyy-MM')
        
        EXCEPT

        SELECT 
            datasource_num_id,
            rollup_category,
            month_of_year,
            total_sales_amount,
            total_sales_amount_usd
        FROM gld_eudm.vw_digital_revenue_dashboard
    )
""")

# COMMAND ----------

# 2. Count the mismatches
mismatch_count = mismatch_df.count()

if mismatch_count > 0:
    print(f"Data validation failed: Found {mismatch_count} mismatched records.")
    
    # Add an audit timestamp column to record exactly when this mismatch was detected
    audit_df = mismatch_df.withColumn("audit_timestamp", current_timestamp())
    
    # Write the mismatched records to an audit table in 'append' mode to keep a historical log
    audit_df.write \
        .format("delta") \
        .mode("append") \
        .saveAsTable("gld_eudm.digital_dashboard_records_mismatch")
    
    # Raise an exception to fail the Databricks Job and trigger failure emails
    raise Exception(f"Digital Dashboard Mismatch Audit Failed! {mismatch_count} rows differ. Please query gld_eudm.digital_dashboard_records_mismatch for details.")

else:
    print("Data validation passed: No mismatches found between the view and summary table.")

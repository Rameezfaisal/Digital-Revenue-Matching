SELECT 
    datasource_num_id,
    invoice_no, 
    order_number, 
    date_invoice, 
    dl_load_date, 
    sales_amount
FROM brz_teradata.udm_sales_fact
WHERE date_invoice < '2024-05-01'  -- An invoice from months ago
  AND dl_load_date > '2024-08-01'  -- That was updated/loaded much later
  AND datasource_num_id = 3000     -- Using WESNET as an example
LIMIT 1;




SELECT 
    invoice_no, 
    order_number, 
    date_invoice, 
    sales_amount, 
    CREATE_DATE
FROM dss_marts.digital_dashboard_control
WHERE invoice_no = '<your_invoice_no>' 
  AND order_number = '<your_order_number>';





SELECT 
    invoice_no, 
    order_number, 
    date_invoice, 
    sales_amount, 
    dl_load_ts,
    dl_updated_ts
FROM gld_eudm.digital_dashboard_control
WHERE invoice_no = '<your_invoice_no>' 
  AND order_number = '<your_order_number>'
ORDER BY dl_updated_ts DESC;







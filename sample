spark.sql(f"""create or replace temporary view incremental_data as

  with getIncrementalData as
  (

  select distinct oh.ORDER_HEADER_KEY 
  from oh_sales_order as oh
  where oh.dl_load_date > '{min_cdc_value}'

  union

  select distinct oh.ORDER_HEADER_KEY 
  from oh_sales_order as oh
  inner join eoh_sales_order as eoh 
  on eoh.order_header_key=oh.order_header_key
  where eoh.dl_load_date > '{min_cdc_value}'

  union

  select distinct oh.ORDER_HEADER_KEY 
  from oh_sales_order as oh
  inner join slv_hr.employee e 
  on e.employee_number = oh.ENTERED_BY 
  where e.dl_updated_ts > '{min_cdc_value}'

  union

  select distinct oh.ORDER_HEADER_KEY 
  from oh_sales_order as oh
  inner join dso_sales_order as dso 
  on dso.ordernumber=oh.order_no
  where dso.dl_load_date > '{min_cdc_value}'

  union

  select distinct oh.ORDER_HEADER_KEY 
  from oh_sales_order as oh
  inner join dso_sales_order as dso 
  on dso.ordernumber=oh.order_no
  inner join slv_hr.employee loa ON regexp_extract(dso.wesco_loaapprover, '[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}', 0) = loa.employee_email_address
  and upper(loa.employee_status) = 'ACTIVE'
  where loa.dl_updated_ts > '{min_cdc_value}'

  union

  select distinct oh.ORDER_HEADER_KEY 
  from oh_sales_order as oh
  inner join dso_sales_order as dso 
  on dso.ordernumber=oh.order_no
  inner join systemuser_v as sui on sui.systemuserid = dso.wesco_isr
  inner join slv_hr.employee e 
  on e.employee_number = sui.employeeid
  where (sui.dl_load_date > '{min_cdc_value}' or e.dl_updated_ts > '{min_cdc_value}')

  union

  select distinct oh.ORDER_HEADER_KEY 
  from oh_sales_order as oh
  inner join dso_sales_order as dso 
  on dso.ordernumber=oh.order_no
  inner join systemuser_v as suo on suo.systemuserid = dso.wesco_osr
  inner join slv_hr.employee e 
  on e.employee_number = suo.employeeid
  where (suo.dl_load_date > '{min_cdc_value}' or e.dl_updated_ts > '{min_cdc_value}')

  union

  select distinct oh.ORDER_HEADER_KEY 
  from oh_sales_order as oh
  inner join dso_sales_order as dso 
  on dso.ordernumber=oh.order_no
  inner join quote_v qv 
  on qv.quoteid=dso.quoteid
  where qv.dl_load_date > '{min_cdc_value}'

  union

  select distinct oh.ORDER_HEADER_KEY 
  from oh_sales_order as oh
  inner join dso_sales_order as dso 
  on dso.ordernumber=oh.order_no
  inner join quote_v qv 
  on qv.quoteid=dso.quoteid
  inner join slv_leadtoquote.quote slvq 
  on slvq.quote_number = qv.quotenumber
  where slvq.dl_updated_ts > '{min_cdc_value}'

  union

  select distinct oh.ORDER_HEADER_KEY 
  from oh_sales_order as oh
  inner join ol_sales_order olc 
  on olc.order_header_key=oh.order_header_key
  where olc.dl_load_date > '{min_cdc_value}'
  
  union

  select distinct oh.ORDER_HEADER_KEY 
  from oh_sales_order as oh
  inner join lc_sales_order lc
  on lc.header_key=oh.order_header_key
  where lc.dl_load_date > '{min_cdc_value}'

  union 
  
  select distinct oh.ORDER_HEADER_KEY 
  from oh_sales_order as oh
  inner join dso_sales_order as dso 
  on dso.ordernumber=oh.order_no
  inner join so_wesco_lookup as swl 
  on swl.id = dso.wesco_returnreasoncode
  where swl.dl_load_date > '{min_cdc_value}' or dso.dl_load_date > '{min_cdc_value}'

  union
  
  select distinct oh.ORDER_HEADER_KEY 
  from oh_sales_order as oh
  inner join dso_sales_order as dso 
  on dso.ordernumber=oh.order_no
  inner join so_wesco_lookup as swl1 
  on dso.wesco_governmentrating = swl1.wesco_lookupid
  where swl1.dl_load_date > '{min_cdc_value}' or dso.dl_load_date > '{min_cdc_value}'

  union

  select distinct oh.ORDER_HEADER_KEY 
  from oh_sales_order as oh
  inner join dso_sales_order as dso on dso.ordernumber=oh.order_no
  inner join wc_sales_order as wc on wc.wesco_choicevalue = dso.wesco_orderstatus
  where (dso.dl_load_date > '{min_cdc_value}' or wc.dl_load_date > '{min_cdc_value}')

  union

  select distinct oh.ORDER_HEADER_KEY 
  from oh_sales_order as oh
  inner join dso_sales_order as dso on dso.ordernumber=oh.order_no
  inner join wc_sales_order_compliance as wcpc_sub on dso.wesco_governmentcompliancetype = wcpc_sub.wesco_choicevalue 
  where (dso.dl_load_date > '{min_cdc_value}' or wcpc_sub.dl_load_date > '{min_cdc_value}')

  union

  select distinct oh.ORDER_HEADER_KEY 
  from oh_sales_order as oh
  inner join slv_location.wesco_legal_entity as wle 
  on oh.division = wle.legal_entity_name
  where wle.dl_updated_ts > '{min_cdc_value}'

  union 

  select distinct oh.ORDER_HEADER_KEY 
  from oh_sales_order as oh
  inner join dso_sales_order as dso 
  on dso.ordernumber=oh.order_no
  inner join slv_customer.Customer_Group slv_cg 
  on slv_cg.Customer_Grouping_Guid = dso.wesco_customergroup
  where slv_cg.dl_updated_ts > '{min_cdc_value}'

  union

  select distinct oh.ORDER_HEADER_KEY 
  from oh_sales_order as oh
  inner join (
  select distinct ca.customer_account_number, location_role_id 
  from slv_customer.customer_account ca
  inner join so_customeraccountsite brz_cal on ca.customer_account_id =brz_cal.CUSTACCOUNTID
  inner join slv_customer.customer_account_location cal on brz_cal.CUSTACCTSITEID = cal.customer_account_location_id
  inner join slv_customer.customer_account_location_role calr on calr.customer_account_location_id=cal.customer_account_location_id
  inner join so_partysite ps on ps.PARTYSITEID = brz_cal.PARTYSITEID and ps.PARTYSITENUMBER=ca.customer_account_number
  where (ca.dl_updated_ts > '{min_cdc_value}' or brz_cal.dl_load_date > '{min_cdc_value}' or cal.dl_updated_ts > '{min_cdc_value}' or calr.dl_updated_ts > '{min_cdc_value}' or ps.dl_load_date > '{min_cdc_value}')
  ) as cab on cab.customer_account_number = oh.BILL_TO_ID and cab.location_role_id='2'

  union 

  select distinct oh.ORDER_HEADER_KEY 
  from oh_sales_order as oh
  inner join (
  select distinct ca.customer_account_number, location_role_id 
  from slv_customer.customer_account ca
  inner join so_customeraccountsite brz_cal on ca.customer_account_id =brz_cal.CUSTACCOUNTID
  inner join slv_customer.customer_account_location cal on brz_cal.CUSTACCTSITEID = cal.customer_account_location_id
  inner join slv_customer.customer_account_location_role calr on calr.customer_account_location_id=cal.customer_account_location_id
  inner join so_partysite ps on ps.PARTYSITEID = brz_cal.PARTYSITEID and ps.PARTYSITENUMBER=ca.customer_account_number
  where (ca.dl_updated_ts > '{min_cdc_value}' or brz_cal.dl_load_date > '{min_cdc_value}' or cal.dl_updated_ts > '{min_cdc_value}' or calr.dl_updated_ts > '{min_cdc_value}' or ps.dl_load_date > '{min_cdc_value}')
  ) as cas on cas.customer_account_number = oh.SHIP_TO_ID and cas.location_role_id='1'

  union

  select distinct oh.ORDER_HEADER_KEY 
  from oh_sales_order as oh
  inner join slv_salesorder.sales_order_type as sot 
  on sot.order_type_name=case when oh.order_type is null then oh.chain_type else oh.order_type end
  where sot.dl_updated_ts > '{min_cdc_value}'

  union 

  select distinct oh.ORDER_HEADER_KEY 
  from oh_sales_order as oh
  inner join slv_salesorder.channel as ch 
  on ch.channel_name=oh.entry_type
  where ch.dl_updated_ts > '{min_cdc_value}'
  
  )

  select distinct ORDER_HEADER_KEY from getIncrementalData""")


# COMMAND ----------
# DBTITLE 1,Mismatch (Live Sources EXCEPT Frozen Summary)
mismatch_df = spark.sql("""
WITH live_aggregated AS (
    SELECT 
        datasource_num_id,
        rollup_category,
        date_format(date_invoice, 'yyyy-MM') AS month_of_year,
        CAST(SUM(sales_amount) AS DECIMAL(38,2)) AS total_sales_amount,
        CAST(SUM(sales_amount_USD) AS DECIMAL(38,12)) AS total_sales_amount_usd
    FROM vw_live_bronze_details
    GROUP BY datasource_num_id, rollup_category, date_format(date_invoice, 'yyyy-MM')
),
frozen_summary AS (
    SELECT 
        datasource_num_id,
        rollup_category,
        month_of_year,
        sales_amount AS total_sales_amount,
        sales_amount_usd AS total_sales_amount_usd
    FROM gld_eudm.digital_dashboard_control_summary
    WHERE month_of_year <> date_format(current_date(), 'yyyy-MM')
)
SELECT * FROM live_aggregated
EXCEPT
SELECT * FROM frozen_summary
""")

# COMMAND ----------
# DBTITLE 1,Email Alerts
mismatch_count = mismatch_df.count()
print(f"Total Mismatched Rows found: {mismatch_count}")

# Generate the email structure
msg = MIMEMultipart()
msg['From'] = SENDER_EMAIL
msg['To'] = ", ".join(RECIPIENTS)

if mismatch_count == 0:
    msg['Subject'] = "Digital Dashboard and Source records comparision Daily"
    body = "There is no mismatch between Digital Dashboard and Source Record."
    msg.attach(MIMEText(body, 'plain'))
else:
    msg['Subject'] = "Digital Dashboard and Source records comparision Daily"
    body = "Please find attached the records summary having difference in source and digital dashboard control summary table."
    msg.attach(MIMEText(body, 'plain'))
    
    # Convert DF to CSV in memory
    pd_df = mismatch_df.toPandas()
    csv_buffer = io.StringIO()
    pd_df.to_csv(csv_buffer, index=False)
    csv_bytes = csv_buffer.getvalue().encode('utf-8')
    
    # Attach CSV
    part = MIMEBase('application', 'octet-stream')
    part.set_payload(csv_bytes)
    encoders.encode_base64(part)
    part.add_header('Content-Disposition', 'attachment; filename="Digital_dashboard_records_mismatch.csv"')
    msg.attach(part)

try:
    server = smtplib.SMTP(SMTP_HOST, SMTP_PORT)
    server.starttls()
    server.login(SMTP_USER, SMTP_PASS)
    text = msg.as_string()
    server.sendmail(SENDER_EMAIL, RECIPIENTS, text)
    server.quit()
    print("Email sent successfully.")
except Exception as e:
    print(f"The email task for Digital Dashboard and Source records comparision Daily failed. Error: {str(e)}")
    raise Exception(f"Email failed: {str(e)}")

results = {
    "Status": "Success",
    "mismatch_count": mismatch_count
}
dbutils.notebook.exit(json.dumps(results))

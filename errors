# COMMAND ----------

spark.sql(f"""
CREATE OR REPLACE TEMPORARY VIEW sf_sales_fact AS
SELECT * FROM (
    SELECT *,
    row_number() OVER (
        PARTITION BY datasource_num_id, invoice_no, invoice_line_no, order_number, branch_id
        ORDER BY updated_ts DESC
    ) AS row_num
    FROM (
        SELECT
            datasource_num_id, branch_id, date_invoice, sales_amount, currency, customer_dim_key,
            invoice_no, wesnet_order_no, order_number, order_integration_id, accounting_include_flag,
            sales_transfer_flag, kit_component_flag, sim_description, inventory_org_code,
            cost_amount, quantity, market_cost, transaction_type, invoice_line_no, conversion_rate,
            budget_conversion_rate, flex_1, dl_load_date, updated_ts
        FROM brz_teradata.udm_sales_fact 
        WHERE dl_load_date > '{min_cdc_value}'
    )
) WHERE row_num = 1
""")

# COMMAND ----------

spark.sql(f"""
CREATE OR REPLACE TEMPORARY VIEW of_order_fact AS
SELECT * FROM (
    SELECT *,
    row_number() OVER (
        PARTITION BY datasource_num_id, sales_order_no, invoice_no, WesnetLine
        ORDER BY order_updated_ts DESC
    ) AS row_num
    FROM (
        SELECT
            datasource_num_id, sales_order_no, branch_id, order_integration_id, flex_1,
            ent_type, invoice_no, date_invoice, WesnetLine, dl_load_date, order_updated_ts,
            customer_po_no
        FROM brz_teradata.udm_order_fact
        WHERE dl_load_date > '{min_cdc_value}'
    )
) WHERE row_num = 1
""")

# COMMAND ----------

spark.sql(f"""
CREATE OR REPLACE TEMPORARY VIEW dim_customer AS
SELECT * FROM (
    SELECT *, row_number() OVER (PARTITION BY customer_dim_key ORDER BY updated_ts DESC) AS row_num
    FROM brz_teradata.udm_customer_dim WHERE dl_load_date > '{min_cdc_value}'
) WHERE row_num = 1
""")

spark.sql(f"""
CREATE OR REPLACE TEMPORARY VIEW dim_branch AS
SELECT * FROM (
    SELECT branch_id, sbu, updated_ts, row_number() OVER (PARTITION BY branch_id ORDER BY updated_ts DESC) AS row_num
    FROM brz_teradata.branch_dim WHERE dl_load_date > '{min_cdc_value}'
) WHERE row_num = 1
""")

spark.sql(f"""
CREATE OR REPLACE TEMPORARY VIEW dim_digital_channel AS
SELECT * FROM (
    SELECT ent_type, datasource_num_id, rollup_category, row_number() OVER (PARTITION BY ent_type, datasource_num_id ORDER BY dl_load_date DESC) AS row_num
    FROM brz_teradata.udm_digital_channel_code_dim WHERE dl_load_date > '{min_cdc_value}'
) WHERE row_num = 1
""")

spark.sql(f"""
CREATE OR REPLACE TEMPORARY VIEW ref_conversion_rates AS
SELECT * FROM (
    SELECT from_currency, to_currency, cnv_year, cnv_month, conversion_rate, row_number() OVER (PARTITION BY from_currency, to_currency, cnv_year, cnv_month ORDER BY dl_load_date DESC) AS row_num
    FROM brz_teradata.ora_conv_rates_mthly WHERE dl_load_date > '{min_cdc_value}'
) WHERE row_num = 1
""")

spark.sql(f"""
CREATE OR REPLACE TEMPORARY VIEW ref_datasource AS
SELECT * FROM (
    SELECT datasource_num_id, datasource_description, datasource_name, row_number() OVER (PARTITION BY datasource_num_id ORDER BY dl_load_date DESC) AS row_num
    FROM brz_teradata.datasource_tbl WHERE dl_load_date > '{min_cdc_value}'
) WHERE row_num = 1
""")

spark.sql(f"""
CREATE OR REPLACE TEMPORARY VIEW anixter_conv_rates AS
SELECT * FROM (
    SELECT FROM_CURR_C, rate_type, FISCAL_YY_D, FISCAL_MM_D, CURR_CONV_ACTUAL_F, row_number() OVER (PARTITION BY FROM_CURR_C, rate_type, FISCAL_YY_D, FISCAL_MM_D ORDER BY dl_load_date DESC) AS row_num
    FROM brz_teradata.anixter_monthly_conversion_rate_tbl WHERE dl_load_date > '{min_cdc_value}'
) WHERE row_num = 1
""")










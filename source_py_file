SELECT 
    sf.invoice_no AS sf_invoice,
    uof.invoice_no AS uof_invoice,
    sf.date_invoice AS sf_date,
    uof.date_invoice AS uof_date,
    sf.branch_id AS sf_branch,
    uof.branch_id AS uof_branch,
    uof.ent_type

SELECT DISTINCT 
    uof.flex_1 AS raw_flex_1,
    TRIM(CAST(uof.flex_1 AS STRING)) AS trimmed_flex_1,
    doc_raw.ent_type AS matched_raw,
    doc_trimmed.ent_type AS matched_trimmed,
    doc_trimmed.rollup_category
FROM brz_teradata.udm_order_fact uof
-- Test 1: How your notebook currently joins
LEFT JOIN dim_digital_channel doc_raw 
    ON doc_raw.ent_type = uof.flex_1 
    AND doc_raw.datasource_num_id = uof.datasource_num_id
-- Test 2: How it should join
LEFT JOIN dim_digital_channel doc_trimmed 
    ON doc_trimmed.ent_type = TRIM(CAST(uof.flex_1 AS STRING)) 
    AND CAST(doc_trimmed.datasource_num_id AS INT) = CAST(uof.datasource_num_id AS INT)
WHERE uof.datasource_num_id = 3000 
  AND uof.flex_1 IS NOT NULL;










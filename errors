    -- 9. HC (6000), AED (7000), Needham (8000)
    SELECT sf.datasource_num_id, bd.sbu, uof.ent_type, doc.rollup_category, sf.date_invoice, count(distinct sf.order_number) as total_no_of_sales, sum(sf.sales_amount) as sales_amount, sf.currency, dt.datasource_description as data_source_name, concat(cus.customer_no, '_', cus.customer_name) as cust_name, sf.invoice_no, sf.order_number, coalesce(cr.conversion_rate, 1) as currency_conversion, (cast(sum(sf.sales_amount) as DECIMAL(38,2)) * coalesce(cr.conversion_rate, 1)) as sales_amount_USD, current_date() as CREATE_DATE
    FROM base_incremental_sales sf
    LEFT JOIN (SELECT distinct ent_type, sales_order_no, branch_id, datasource_num_id, invoice_no FROM of_order_fact) uof 
        ON (uof.sales_order_no = sf.wesnet_order_no AND sf.branch_id = uof.branch_id AND uof.datasource_num_id = sf.datasource_num_id AND uof.ent_type IN ('RDC','EDI','MBL','IX') AND concat(uof.sales_order_no, '.', lpad(uof.invoice_no, 3, '0')) = sf.invoice_no)
    LEFT JOIN dim_branch bd ON sf.branch_id = bd.branch_id LEFT JOIN dim_digital_channel doc ON (doc.ent_type = uof.ent_type AND doc.datasource_num_id = sf.datasource_num_id) LEFT JOIN ref_datasource dt ON dt.datasource_num_id = sf.datasource_num_id LEFT JOIN dim_customer cus ON sf.customer_dim_key = cus.customer_dim_key LEFT JOIN ref_conversion_rates cr ON (cr.from_currency = sf.currency AND cr.to_currency = 'USD' AND year(sf.date_invoice) = cr.cnv_year AND month(sf.date_invoice) = cr.cnv_month)
    WHERE sf.datasource_num_id IN (6000, 7000, 8000)
    GROUP BY sf.datasource_num_id, uof.ent_type, bd.sbu, doc.rollup_category, sf.date_invoice, sf.currency, cus.customer_name, cus.customer_no, sf.invoice_no, sf.order_number, dt.datasource_description, cr.conversion_rate
    HAVING sum(sf.sales_amount) <> 0

    UNION ALL

    -- 10. Anixter Eclipse (12001)
    SELECT sf.datasource_num_id, bd.sbu, uof.ent_type1 as ent_type, doc.rollup_category, sf.date_invoice, count(distinct sf.order_number) as total_no_of_sales, sum(sf.sales_amount) as sales_amount, sf.currency, dt.datasource_name as data_source_name, concat(cus.customer_no, '_', cus.customer_name) as cust_name, sf.invoice_no, sf.order_number, coalesce(CASE WHEN sf.currency = 'USD' THEN 1 ELSE coalesce(cr.conversion_rate, acr.CURR_CONV_ACTUAL_F) END, sf.conversion_rate) as currency_conversion, (cast(sum(sf.sales_amount) as DECIMAL(38,2)) * coalesce(CASE WHEN sf.currency = 'USD' THEN 1 ELSE coalesce(cr.conversion_rate, acr.CURR_CONV_ACTUAL_F) END, sf.conversion_rate)) as sales_amount_USD, current_date() as CREATE_DATE
    FROM base_incremental_sales sf
    LEFT JOIN (SELECT distinct sales_order_no, invoice_no, CASE WHEN trim(ent_type) = 'EDI' THEN 'EDI Sales' WHEN ent_type = 'WOE' THEN 'Web Order Entry (WOE)' WHEN ent_type = 'MBAS' THEN 'Virtual Warehouse' WHEN ent_type = 'CRM' THEN 'Vending Machines' WHEN ent_type = 'Manual' AND customer_po_no = 'CRIBMASTER' THEN 'Vending Machines' ELSE ent_type END as ent_type1 FROM of_order_fact WHERE datasource_num_id = 12001) uof 
        ON (uof.sales_order_no = sf.order_number AND trim(concat(uof.sales_order_no, '.', uof.invoice_no)) = sf.invoice_no)
    LEFT JOIN dim_branch bd ON sf.branch_id = bd.branch_id LEFT JOIN dim_digital_channel doc ON (doc.ent_type = uof.ent_type1 AND doc.datasource_num_id = sf.datasource_num_id) LEFT JOIN ref_datasource dt ON dt.datasource_num_id = sf.datasource_num_id LEFT JOIN dim_customer cus ON sf.customer_dim_key = cus.customer_dim_key LEFT JOIN ref_conversion_rates cr ON (cr.from_currency = sf.currency AND cr.to_currency = 'USD' AND year(sf.date_invoice) = cr.cnv_year AND month(sf.date_invoice) = cr.cnv_month) LEFT JOIN anixter_conv_rates acr ON (acr.FROM_CURR_C = sf.currency AND acr.rate_type = 'MTEND' AND year(sf.date_invoice) = acr.FISCAL_YY_D AND month(sf.date_invoice) = acr.FISCAL_MM_D)
    WHERE sf.datasource_num_id = 12001 AND sf.accounting_include_flag = 'Y' AND coalesce(sf.sales_transfer_flag, 'N') <> 'Y' AND coalesce(sf.kit_component_flag, 'N') <> 'C' AND coalesce(cus.intercompany_customer, 'N') <> 'Y'
    GROUP BY sf.datasource_num_id, uof.ent_type1, bd.sbu, doc.rollup_category, sf.date_invoice, sf.currency, cus.customer_name, cus.customer_no, sf.invoice_no, sf.order_number, dt.datasource_name, currency_conversion
    HAVING sum(sf.sales_amount) <> 0

    UNION ALL

    -- 11. Anixter SXE USA, CAN, Mainframe (12002, 12003, 12004)
    SELECT sf.datasource_num_id, bd.sbu, uof.ent_type, doc.rollup_category, sf.date_invoice, count(distinct sf.order_number) as total_no_of_sales, sum(sf.sales_amount) as sales_amount, sf.currency, dt.datasource_description as data_source_name, concat(cus.customer_no, '_', cus.customer_name) as cust_name, sf.invoice_no, sf.order_number, coalesce(CASE WHEN sf.currency = 'USD' THEN 1 ELSE acr.CURR_CONV_ACTUAL_F END, sf.budget_conversion_rate) as currency_conversion, (cast(sum(sf.sales_amount) as DECIMAL(38,2)) * coalesce(CASE WHEN sf.currency = 'USD' THEN 1 ELSE acr.CURR_CONV_ACTUAL_F END, sf.budget_conversion_rate)) as sales_amount_USD, current_date() as CREATE_DATE
    FROM base_incremental_sales sf
    LEFT JOIN (SELECT distinct ent_type, sales_order_no, branch_id, datasource_num_id, invoice_no, date_invoice FROM of_order_fact) uof 
        ON (sf.branch_id = uof.branch_id AND uof.datasource_num_id = sf.datasource_num_id AND uof.date_invoice = sf.date_invoice AND uof.invoice_no = CASE WHEN instr(sf.invoice_no, '-') > 0 THEN substring(sf.invoice_no, 1, instr(sf.invoice_no, '-') - 1) ELSE sf.invoice_no END AND uof.sales_order_no = sf.order_number)
    LEFT JOIN dim_branch bd ON sf.branch_id = bd.branch_id LEFT JOIN dim_digital_channel doc ON (doc.ent_type = uof.ent_type AND doc.datasource_num_id = sf.datasource_num_id) LEFT JOIN ref_datasource dt ON dt.datasource_num_id = sf.datasource_num_id LEFT JOIN dim_customer cus ON sf.customer_dim_key = cus.customer_dim_key LEFT JOIN anixter_conv_rates acr ON (acr.FROM_CURR_C = sf.currency AND acr.rate_type = 'MTEND' AND year(sf.date_invoice) = acr.FISCAL_YY_D AND month(sf.date_invoice) = acr.FISCAL_MM_D)
    WHERE sf.datasource_num_id IN (12002, 12003, 12004) AND trunc(sf.date_invoice, 'MM') <> trunc(current_date(), 'MM') AND coalesce(cus.intercompany_customer, 'N') <> 'Y'
    GROUP BY sf.datasource_num_id, uof.ent_type, bd.sbu, doc.rollup_category, sf.date_invoice, sf.currency, cus.customer_name, cus.customer_no, sf.invoice_no, sf.order_number, dt.datasource_description, currency_conversion
    HAVING sum(sf.sales_amount) <> 0

    UNION ALL

    -- 12. Anixter Rubicon (12005)
    SELECT sf.datasource_num_id, bd.sbu, CASE WHEN uof.ent_type = 'A' THEN 'EDI Sales' ELSE uof.ent_type END as ent_type, CASE WHEN uof.ent_type = 'A' THEN 'Integrations' ELSE doc.rollup_category END as rollup_category, sf.date_invoice, count(distinct sf.order_number) as total_no_of_sales, sum(sf.sales_amount) as sales_amount, sf.currency, dt.datasource_name as data_source_name, concat(cus.customer_no, '_', cus.customer_name) as cust_name, sf.invoice_no, sf.order_number, coalesce(CASE WHEN sf.currency = 'USD' THEN 1 ELSE coalesce(cr.conversion_rate, acr.CURR_CONV_ACTUAL_F) END, sf.conversion_rate) as currency_conversion, (cast(sum(sf.sales_amount) as DECIMAL(38,2)) * coalesce(CASE WHEN sf.currency = 'USD' THEN 1 ELSE coalesce(cr.conversion_rate, acr.CURR_CONV_ACTUAL_F) END, sf.conversion_rate)) as sales_amount_USD, current_date() as CREATE_DATE
    FROM base_incremental_sales sf
    LEFT JOIN (SELECT distinct ent_type, sales_order_no, branch_id, datasource_num_id, invoice_no, date_invoice FROM of_order_fact) uof 
        ON (sf.branch_id = uof.branch_id AND uof.datasource_num_id = sf.datasource_num_id AND uof.sales_order_no = cast(sf.order_number as string))
    LEFT JOIN dim_branch bd ON sf.branch_id = bd.branch_id LEFT JOIN dim_digital_channel doc ON (doc.ent_type = uof.ent_type AND doc.datasource_num_id = sf.datasource_num_id) LEFT JOIN ref_datasource dt ON dt.datasource_num_id = sf.datasource_num_id LEFT JOIN dim_customer cus ON sf.customer_dim_key = cus.customer_dim_key LEFT JOIN ref_conversion_rates cr ON (cr.from_currency = sf.currency AND cr.to_currency = 'USD' AND year(sf.date_invoice) = cr.cnv_year AND month(sf.date_invoice) = cr.cnv_month) LEFT JOIN anixter_conv_rates acr ON (acr.FROM_CURR_C = sf.currency AND acr.rate_type = 'MTEND' AND year(sf.date_invoice) = acr.FISCAL_YY_D AND month(sf.date_invoice) = acr.FISCAL_MM_D)
    WHERE sf.datasource_num_id = 12005 AND sf.accounting_include_flag = 'Y' AND coalesce(sf.sales_transfer_flag, 'N') <> 'Y' AND coalesce(sf.kit_component_flag, 'N') <> 'C'
    GROUP BY sf.datasource_num_id, uof.ent_type, bd.sbu, doc.rollup_category, sf.date_invoice, sf.currency, cus.customer_name, cus.customer_no, sf.invoice_no, sf.order_number, dt.datasource_name, currency_conversion
    HAVING sum(sf.sales_amount) <> 0
)

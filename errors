SELECT 
    datasource_num_id, 
    MIN(date_invoice) as min_date_invoice, 
    COUNT(*) as row_cnt
FROM dss_marts.digital_dashboard_control
WHERE datasource_num_id IN (3000, 10000, 11000)
GROUP BY datasource_num_id
ORDER BY datasource_num_id;





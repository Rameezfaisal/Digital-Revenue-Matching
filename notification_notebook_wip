%sql
-- Proof of Data Drift: May orders modified AFTER the dashboard snapshot
SELECT
    datasource_num_id,
    order_number,
    date_invoice,
    sales_amount,
    updated_ts AS late_system_update
FROM brz_teradata.udm_sales_fact
WHERE to_date(date_invoice) BETWEEN '2025-05-01' AND '2025-05-31'
  AND updated_ts > '2025-06-05'
LIMIT 5;







%sql
-- Check how much USD revenue was artificially inflated by missing conversion rates
SELECT 
    currency,
    COUNT(*) as total_orders_affected,
    ROUND(SUM(sales_amount), 2) as artificially_inflated_usd_total
FROM gld_eudm.digital_dashboard_control
WHERE datasource_num_id = 3000
  AND date_invoice >= '2025-05-01' 
  AND date_invoice <= '2025-05-31'
  AND currency != 'USD'
  AND currency_conversion IS NULL; -- Flags the rows where COALESCE(rate, 1) took over





 %sql
 -- Create the view by aggregating the deduplicated silver/gold table. 
 -- The current month is excluded to match the Teradata script's logic.

 CREATE OR REPLACE VIEW gld_eudm.vw_digital_revenue_dashboard AS
 WITH latest_dashboard_control AS (
     SELECT * FROM (
         SELECT *,
             row_number() OVER (
                 PARTITION BY datasource_num_id, invoice_no, order_number, date_invoice, ent_type, rollup_category, currency
                 ORDER BY dl_updated_ts DESC, dl_load_ts DESC, sales_amount DESC
             ) as dedup_row
         FROM gld_eudm.digital_dashboard_control
     )
     WHERE dedup_row = 1
 )
 SELECT 
     datasource_num_id,
     rollup_category,
     date_format(date_invoice, 'yyyy-MM') AS month_of_year,
     CAST(SUM(sales_amount) AS DECIMAL(38,2)) AS total_sales_amount,
     CAST(SUM(sales_amount_usd) AS DECIMAL(38,12) )AS total_sales_amount_usd
 FROM latest_dashboard_control
 WHERE date_format(date_invoice, 'yyyy-MM') <> date_format(current_date(), 'yyyy-MM')
 GROUP BY 
     datasource_num_id,
     rollup_category,
     date_format(date_invoice, 'yyyy-MM');






%sql
CREATE OR REPLACE TEMPORARY VIEW latest_dashboard_control AS
SELECT * FROM (
    SELECT *,
        row_number() OVER (
            PARTITION BY datasource_num_id, invoice_no, order_number, date_invoice, ent_type, rollup_category, currency
            ORDER BY dl_updated_ts DESC, dl_load_ts DESC, sales_amount DESC
        ) as row_no
    FROM gld_eudm.digital_dashboard_control
)
WHERE row_no = 1;


main_df = spark.sql(f"""
WITH changed_months AS (
    -- Find which months actually had new or updated data in this incremental run
    SELECT DISTINCT date_format(date_invoice, 'yyyy-MM') AS month_of_year
    FROM gld_eudm.digital_dashboard_control
    WHERE dl_updated_ts > '{min_cdc_value}'
)
SELECT 
    datasource_num_id,
    rollup_category,
    date_format(date_invoice, 'yyyy-MM') AS month_of_year,
    CAST(SUM(total_no_of_sales) AS BIGINT) AS total_no_of_sales,
    CAST(SUM(sales_amount) AS DECIMAL(38,2)) AS sales_amount,
    CAST(SUM(sales_amount_usd) AS DECIMAL(38,12)) AS sales_amount_usd,
    current_date() AS create_date
FROM latest_dashboard_control 
WHERE datasource_num_id IN (3000, 4000, 5000, 6000, 7000, 8000, 9000, 10000, 11000, 12001, 12002, 12003, 12004, 12005, 13000, 14000)
  -- Only recalculate the full totals for months that had changes
  AND date_format(date_invoice, 'yyyy-MM') IN (SELECT month_of_year FROM changed_months)
GROUP BY 
    datasource_num_id,
    rollup_category,
    date_format(date_invoice, 'yyyy-MM')
""")




try:
    spark.sql(f"""
        MERGE INTO gld_eudm.digital_dashboard_control_summary AS t
        USING (
            SELECT * 
            FROM final_df
        ) AS s
        ON t.datasource_num_id = s.datasource_num_id
        AND coalesce(t.rollup_category, '') = coalesce(s.rollup_category, '')
        AND t.month_of_year = s.month_of_year

        WHEN MATCHED THEN
        UPDATE SET
            t.total_no_of_sales = s.total_no_of_sales,
            t.sales_amount = s.sales_amount,
            t.sales_amount_usd = s.sales_amount_usd,
            t.create_date = s.create_date,
            t.dl_updated_ts = '{max_cdc_value}'

        WHEN NOT MATCHED THEN
        INSERT (
            datasource_num_id,
            rollup_category,
            month_of_year,
            total_no_of_sales,
            sales_amount,
            sales_amount_usd,
            create_date,
            dl_load_ts,
            dl_updated_ts
        )
        VALUES (
            s.datasource_num_id,
            s.rollup_category,
            s.month_of_year,
            s.total_no_of_sales,
            s.sales_amount,
            s.sales_amount_usd,
            s.create_date,
            '{max_cdc_value}',
            '{max_cdc_value}'
        )
    """)

    results = {
        "Status": "Success",
        "cdc_value": str(max_cdc_value)
    }

    dbutils.notebook.exit(json.dumps(results))

except Exception as e:
    results = {
        "Status": "Failed",
        "error_message": str(e),
        "cdc_value": str(min_cdc_value)
    }

    raise Exception(json.dumps(results))




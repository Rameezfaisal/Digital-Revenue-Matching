import smtplib, ssl, ast, io
from email.mime.text import MIMEText
from email.mime.multipart import MIMEMultipart
from email.mime.base import MIMEBase
from email import encoders
from datetime import date
from pyspark.sql.functions import current_timestamp

# --- Configuration Settings 
SMTP_HOST = "smtp.office365.com"
SMTP_PORT = 587

# Fetch credentials securely using the scope
SMTP_USER = dbutils.secrets.get("ddpscopekeyvault001", "kvSvcDDPDatabricksNPUserName")
SMTP_PASS = dbutils.secrets.get("ddpscopekeyvault001", "kvSvcDDPDatabricksnp")

# Important: The sender email usually needs to match the authenticated user 
# or an allowed alias when using Office365 SMTP.
SENDER_EMAIL = SMTP_USER 

# recipient list
params = ast.literal_eval(dbutils.widgets.get("parameter_dictionary"))
RECIPIENTS = params.get("email_recipients", [])


SUBJECT = "Digital Dashboard and Source records comparision Daily"

def send_smtp_email(subject, body, recipients, csv_content=None, csv_filename="mismatch_records.csv"):
    """Utility function to send emails securely via Office365 SMTP with optional CSV attachment."""
    msg = MIMEMultipart()
    msg['From'] = SENDER_EMAIL
    msg['To'] = ", ".join(recipients)
    msg['Subject'] = subject

    msg.attach(MIMEText(body, 'plain'))

    # Attach CSV if provided
    if csv_content is not None:
        part = MIMEBase('application', 'octet-stream')
        part.set_payload(csv_content.encode('utf-8'))
        encoders.encode_base64(part)
        part.add_header('Content-Disposition', f'attachment; filename="{csv_filename}"')
        msg.attach(part)

    try:
        # Create a secure SSL context and authenticate 
        ctx = ssl.create_default_context()
        with smtplib.SMTP(SMTP_HOST, SMTP_PORT, timeout=30) as s:
            s.ehlo()
            s.starttls(context=ctx)
            s.ehlo()
            s.login(SMTP_USER, SMTP_PASS)
            s.sendmail(SENDER_EMAIL, recipients, msg.as_string())
            
        print(f"Email sent successfully to {', '.join(recipients)}")
    except Exception as e:
        print(f"Failed to send email via SMTP: {str(e)}")
        raise e


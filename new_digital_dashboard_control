main_df = spark.sql(f"""
WITH base_incremental_sales AS (
SELECT * FROM sf_sales_fact
WHERE (modifyts > '{min_cdc_value}' OR '{reload}' = 'Y')
AND date_invoice < trunc(current_date(), 'MM')
)
SELECT * FROM (
-- 1. WESNET (3000)
SELECT
sf.datasource_num_id, bd.sbu, uof.flex_1 as ent_type, doc.rollup_category, sf.date_invoice,
count(*) as total_no_of_sales, sum(sf.sales_amount) as sales_amount, sf.currency,
dt.datasource_description as data_source_name, concat(cus.customer_no, '_', cus.customer_name) as cust_name,
sf.invoice_no, sf.wesnet_order_no as order_number,
coalesce(cr.conversion_rate, 1) as currency_conversion,
(cast(sum(sf.sales_amount) as DECIMAL(38,2)) * coalesce(cr.conversion_rate, 1)) as sales_amount_USD,
current_date() as CREATE_DATE
FROM base_incremental_sales sf
LEFT JOIN of_order_fact uof ON (uof.sales_order_no = sf.wesnet_order_no AND uof.datasource_num_id = sf.datasource_num_id AND uof.branch_id = sf.branch_id AND uof.order_integration_id = sf.order_integration_id)
LEFT JOIN dim_branch bd ON sf.branch_id = bd.branch_id
LEFT JOIN dim_digital_channel doc ON (doc.ent_type = uof.flex_1 AND doc.datasource_num_id = uof.datasource_num_id)
LEFT JOIN ref_datasource dt ON dt.datasource_num_id = sf.datasource_num_id
LEFT JOIN dim_customer cus ON sf.customer_dim_key = cus.customer_dim_key
LEFT JOIN ref_conversion_rates cr ON (cr.from_currency = sf.currency AND cr.to_currency = 'USD' AND year(sf.date_invoice) = cr.cnv_year AND month(sf.date_invoice) = cr.cnv_month)
WHERE sf.datasource_num_id = 3000 AND sf.accounting_include_flag = 'Y' AND coalesce(sf.sales_transfer_flag, 'N') <> 'Y' AND coalesce(sf.kit_component_flag, 'N') <> 'C' AND left(cus.customer_no, 1) <> 'X' AND sf.sim_description <> 'Datacom Redaction' AND coalesce(sf.inventory_org_code, '') <> 'SCS' AND (sf.sales_amount <> 0 OR sf.cost_amount <> 0 OR sf.quantity <> 0 OR sf.market_cost <> 0) AND sf.transaction_type <> 'X99'
GROUP BY sf.datasource_num_id, uof.flex_1, bd.sbu, doc.rollup_category, sf.date_invoice, sf.currency, cus.customer_name, cus.customer_no, sf.invoice_no, sf.wesnet_order_no, dt.datasource_description, cr.conversion_rate
HAVING sum(sf.sales_amount) <> 0
UNION ALL
-- 2. LIBERTY (5000)
SELECT
sf.datasource_num_id, bd.sbu, uof.ent_type, doc.rollup_category, sf.date_invoice,
count(distinct sf.order_number) as total_no_of_sales, sum(sf.sales_amount) as sales_amount, sf.currency,
dt.datasource_description as data_source_name, concat(cus.customer_no, '_', cus.customer_name) as cust_name,
sf.invoice_no, sf.order_number,
coalesce(cr.conversion_rate, 1) as currency_conversion,
(cast(sum(sf.sales_amount) as DECIMAL(38,2)) * coalesce(cr.conversion_rate, 1)) as sales_amount_USD,
current_date() as CREATE_DATE
FROM base_incremental_sales sf
LEFT JOIN of_order_fact uof ON (uof.sales_order_no = sf.order_number AND sf.branch_id = uof.branch_id AND uof.datasource_num_id = 5000)
LEFT JOIN dim_branch bd ON sf.branch_id = bd.branch_id
LEFT JOIN dim_digital_channel doc ON (doc.ent_type = uof.ent_type AND doc.datasource_num_id = sf.datasource_num_id)
LEFT JOIN ref_datasource dt ON dt.datasource_num_id = sf.datasource_num_id
LEFT JOIN dim_customer cus ON sf.customer_dim_key = cus.customer_dim_key
LEFT JOIN ref_conversion_rates cr ON (cr.from_currency = sf.currency AND cr.to_currency = 'USD' AND year(sf.date_invoice) = cr.cnv_year AND month(sf.date_invoice) = cr.cnv_month)
WHERE sf.datasource_num_id = 5000
GROUP BY sf.datasource_num_id, uof.ent_type, bd.sbu, doc.rollup_category, sf.date_invoice, sf.currency, cus.customer_name, cus.customer_no, sf.invoice_no, sf.order_number, dt.datasource_description, cr.conversion_rate
HAVING sum(sf.sales_amount) <> 0
UNION ALL
-- 3. HC (6000), AED (7000), Needham (8000), ERP (9000), WIS (10000), EECOL (11000), Conney (13000), Hazmasters (14000)
-- Grouping similarly structured logic for brevity in Spark SQL
SELECT
sf.datasource_num_id, bd.sbu, uof.ent_type, doc.rollup_category, sf.date_invoice,
count(distinct sf.order_number) as total_no_of_sales, sum(sf.sales_amount) as sales_amount, sf.currency,
dt.datasource_description as data_source_name, concat(cus.customer_no, '_', cus.customer_name) as cust_name,
sf.invoice_no, sf.order_number,
coalesce(cr.conversion_rate, 1) as currency_conversion,
(cast(sum(sf.sales_amount) as DECIMAL(38,2)) * coalesce(cr.conversion_rate, 1)) as sales_amount_USD,
current_date() as CREATE_DATE
FROM base_incremental_sales sf
LEFT JOIN of_order_fact uof ON (uof.sales_order_no = sf.order_number AND sf.branch_id = uof.branch_id)
LEFT JOIN dim_branch bd ON sf.branch_id = bd.branch_id
LEFT JOIN dim_digital_channel doc ON (doc.ent_type = uof.ent_type AND doc.datasource_num_id = sf.datasource_num_id)
LEFT JOIN ref_datasource dt ON dt.datasource_num_id = sf.datasource_num_id
LEFT JOIN dim_customer cus ON sf.customer_dim_key = cus.customer_dim_key
LEFT JOIN ref_conversion_rates cr ON (cr.from_currency = sf.currency AND cr.to_currency = 'USD' AND year(sf.date_invoice) = cr.cnv_year AND month(sf.date_invoice) = cr.cnv_month)
WHERE sf.datasource_num_id IN (6000, 7000, 8000, 9000, 10000, 11000, 13000, 14000)
AND coalesce(sf.sales_transfer_flag, 'N') <> 'Y' AND coalesce(sf.kit_component_flag, 'N') <> 'C'
GROUP BY sf.datasource_num_id, uof.ent_type, bd.sbu, doc.rollup_category, sf.date_invoice, sf.currency, cus.customer_name, cus.customer_no, sf.invoice_no, sf.order_number, dt.datasource_description, cr.conversion_rate
HAVING sum(sf.sales_amount) <> 0
)
""")
